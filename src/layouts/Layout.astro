---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: string;
  /** Active local-nav index: 0 home · 1 posts · 2 tags · 3 about · 4 cve · 5 security news · 6 rss. Auto-detected if omitted. */
  active?: number;
  /** Prompt path shown on the right of the local nav, e.g. "posts/zdi-25-1055". */
  path?: string;
  /** Centered content max-width in px. */
  maxWidth?: number;
  /** Show the 2px green reading-progress bar (post pages). */
  progress?: boolean;
  /** Skip the centered .v11-wrap container (page provides its own grid). */
  bare?: boolean;
}

const {
  title = 'xmin.blog',
  description = '주수민의 보안 리서치 노트 — 퍼징, 바이너리 분석, AI',
  canonical = new URL(Astro.url.pathname, 'https://xmin.blog').toString(),
  noindex = false,
  ogType = 'website',
  path = '',
  maxWidth = 1080,
  progress = false,
  bare = false,
} = Astro.props;

const pathname = Astro.url.pathname;
function autoActive() {
  if (pathname === '/' || pathname === '') return 0;
  if (pathname.startsWith('/posts') || pathname.startsWith('/post') || pathname.startsWith('/blog')) return 1;
  if (pathname.startsWith('/tags')) return 2;
  if (pathname.startsWith('/about')) return 3;
  if (pathname.startsWith('/cve')) return 4;
  if (pathname.startsWith('/security-news')) return 5;
  if (pathname.startsWith('/rss')) return 6;
  return -1;
}
const active = Astro.props.active ?? autoActive();

const sites = [
  ['Portfolio', 'https://xmin.sh', false],
  ['Blog', '/', true],
  ['GitHub', 'https://github.com/xmin-02', false],
  ['Contact', 'mailto:x@xmin.sh', false],
];
const local = [
  ['home', '/'],
  ['posts', '/posts'],
  ['tags', '/tags'],
  ['about', '/about'],
  ['cve', '/cve'],
  ['security news', '/security-news'],
  ['rss', '/rss.xml'],
];

const apiBase = import.meta.env.PUBLIC_API_BASE || 'https://api.xmin.cloud';
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="xmin.blog" href="/rss.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://cdn.jsdelivr.net/gh/Joungkyun/font-d2coding/D2Coding.woff2" />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script define:vars={{ apiBase }}>
      window.__XMIN_API_BASE__ = apiBase;
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    {progress && <div class="v11-progress" id="read-progress"></div>}

    <!-- global bar — matches xmin.io -->
    <div class="v11-globalbar">
      <a href="/" class="v11-brand">xmin<span class="v11-gr">.</span></a>
      <nav class="v11-globalnav">
        {sites.map(([name, href, isBlog]) => (
          <a
            href={href}
            class={isBlog ? 'is-active' : ''}
            target={String(href).startsWith('http') || String(href).startsWith('mailto') ? '_blank' : undefined}
            rel={String(href).startsWith('http') ? 'noopener' : undefined}
          >{name}{isBlog && <span class="v11-gr"> ●</span>}</a>
        ))}
      </nav>
      <span class="v11-guest" id="v11-auth">guest@xmin <span class="v11-gr">~</span> $</span>
    </div>

    <!-- local blog nav -->
    <div class="v11-localbar">
      <nav class="v11-localnav">
        {local.map(([name, href], i) => (
          <a href={href} class={active === i ? 'is-active' : ''}>{active === i && <span class="v11-gr">·</span>}{name}</a>
        ))}
      </nav>
      <span class="v11-promptpath"><span class="v11-dim">~/</span><span class="v11-gr">{path}</span> $<span class="v11-cursor"></span></span>
    </div>

    <main class="flex-1">
      {bare ? <slot /> : (
        <div class="v11-wrap" style={`max-width:${maxWidth}px`}>
          <slot />
        </div>
      )}
    </main>

    <script is:inline>
      (function () {
        var el = document.getElementById('v11-auth');
        if (!el) return;
        function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
        window.v11Logout = function (e) {
          if (e) e.preventDefault();
          localStorage.removeItem('auth_token');
          localStorage.removeItem('auth_user');
          location.reload();
        };
        var token = localStorage.getItem('auth_token');
        var raw = localStorage.getItem('auth_user');
        var user = null;
        try { user = raw ? JSON.parse(raw) : null; } catch (e) {}
        if (token && user) {
          var nick = esc(user.nickname || (user.email ? user.email.split('@')[0] : 'user'));
          var admin = user.role === 'admin';
          el.innerHTML = nick + '@xmin <span class="v11-gr">~</span> $'
            + (admin ? ' <a href="/post#new" class="v11-auth-link">+new</a> <a href="/admin" class="v11-auth-link">admin</a>' : '')
            + ' <a href="/mypage" class="v11-auth-link">mypage</a>'
            + ' <a href="#" onclick="v11Logout(event)" class="v11-auth-link v11-auth-dim">logout</a>';
        } else {
          el.innerHTML = 'guest@xmin <span class="v11-gr">~</span> $ <a href="/login" class="v11-auth-link">login</a>';
        }
      })();
    </script>

    {progress && (
      <script is:inline>
        (function () {
          var bar = document.getElementById('read-progress');
          if (!bar) return;
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          function update() {
            var h = document.documentElement;
            var max = h.scrollHeight - h.clientHeight;
            var pct = max > 0 ? (h.scrollTop || document.body.scrollTop) / max : 0;
            bar.style.width = (pct * 100).toFixed(2) + '%';
          }
          if (!reduce) {
            window.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update);
          }
          update();
        })();
      </script>
    )}
  </body>
</html>

<style>
  .v11-globalbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 36px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
  }
  .v11-brand {
    color: var(--color-fg);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .v11-brand:hover { text-decoration: none; }
  .v11-globalnav { display: flex; gap: 20px; font-size: 12.5px; }
  .v11-globalnav a { color: var(--color-subtle); font-weight: 400; }
  .v11-globalnav a.is-active { color: var(--color-fg); font-weight: 600; }
  .v11-globalnav a:hover { color: var(--color-green-br); text-decoration: none; }
  .v11-guest { color: var(--color-dim); font-size: 11.5px; }
  .v11-guest :global(.v11-auth-link) { color: var(--color-green); margin-left: 4px; }
  .v11-guest :global(.v11-auth-link:hover) { color: var(--color-green-br); }
  .v11-guest :global(.v11-auth-dim) { color: var(--color-dim); }

  .v11-localbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 36px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-panel);
    font-family: var(--font-mono);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .v11-localnav { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12.5px; }
  .v11-localnav a { color: var(--color-subtle); font-weight: 400; white-space: nowrap; }
  .v11-localnav a.is-active { color: var(--color-fg); font-weight: 600; }
  .v11-localnav a:hover { color: var(--color-green-br); text-decoration: none; }
  .v11-promptpath { color: var(--color-subtle); font-size: 12px; }

  @media (max-width: 640px) {
    .v11-globalbar { padding: 11px 18px; flex-wrap: wrap; gap: 8px; }
    .v11-globalnav { gap: 14px; order: 3; width: 100%; }
    .v11-localbar { padding: 8px 18px; }
    .v11-localnav { gap: 14px; }
    .v11-promptpath { display: none; }
    .v11-wrap { padding-left: 18px; padding-right: 18px; }
  }
</style>
