---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: string;
  active?: number;
  path?: string;
  progress?: boolean;
}

const {
  title,
  description = '주수민의 보안 리서치 노트 — 퍼징, 바이너리 분석, AI',
  canonical,
  noindex = false,
  ogType = 'website',
  active,
  path = '',
  progress = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  ogType={ogType}
  active={active}
  path={path}
  progress={progress}
  bare={true}
>
  <slot />
</Layout>
