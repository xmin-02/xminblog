---
interface Props {
  weeks?: number;
  commits?: number;
  streak?: string;
}
const { weeks = 53, commits = 218, streak = '14d' } = Astro.props;

const colors = ['#0e0e0e', '#0d2a16', '#11512a', '#1f8c42', '#3fb950'];
// Deterministic placeholder activity (sin-based — matches design reference).
const cells: number[] = [];
for (let w = 0; w < weeks; w++) {
  for (let d = 0; d < 7; d++) {
    const v = Math.min(4, Math.max(0, Math.floor((Math.sin(w * 2.3 + d * 1.1) + 1) * 2.3) + (w > weeks - 7 ? 1 : 0)));
    cells.push(v);
  }
}
---
<div class="v11-heat-wrap">
  <div class="v11-heat-head">
    <span class="v11-dim" style="font-size:12.5px;"><span class="v11-gr">$</span> uptime --activity</span>
    <span class="v11-dim" style="font-size:11.5px;">{commits} commits · streak <span class="v11-gr">{streak}</span></span>
  </div>
  <div class="v11-heat-body">
    <div class="v11-heat-grid">
      {cells.map((v) => <span class="ascii-cell" style={`background:${colors[v]}`}></span>)}
    </div>
    <div class="v11-dim" style="font-size:11px;line-height:1.7;">
      less {colors.map((c) => <span class="ascii-cell" style={`background:${c};margin:0 1px;`}></span>)} more
    </div>
  </div>
</div>

<style>
  .v11-heat-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 12px; font-family: var(--font-mono);
  }
  .v11-heat-body { display: flex; gap: 20px; align-items: flex-start; overflow-x: auto; }
  .v11-heat-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 9px);
    gap: 2px;
    flex-shrink: 0;
  }
</style>
