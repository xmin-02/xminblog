          &nbsp;|&nbsp; <b>선택</b>: 태그 · 대표이미지 · 비공개 암호
        </div>

        <!-- Category + date row (required) -->
        <div class="grid grid-cols-2 gap-4 mb-5" style="max-width:520px;">
          <div>
            <label class="edit-field-label" for="edit-category">카테고리<span class="edit-required">*</span></label>
            <input id="edit-category" type="text" value="${esc(post.category || '')}" placeholder="예: Linux, AI, 보안"
              class="text-xs font-semibold px-3 py-1.5 rounded-full outline-none transition-all w-full"
              style="background:rgba(63,185,80,0.1);color:var(--color-accent);border:1.5px dashed rgba(63,185,80,0.4);" />
          </div>
          <div>
            <label class="edit-field-label" for="edit-date">날짜<span class="edit-required">*</span></label>
