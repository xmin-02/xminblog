        <div id="rich-editor" class="rich-editor"></div>
      </article>
    `;

    const mount = document.getElementById('rich-editor');
    if (!mount) return;
    mount.innerHTML = '<p class="text-xs" style="color:var(--color-text-secondary);">에디터 로딩 중...</p>';
    waitForEditor().then(ok => {
      if (!ok || !window.createBlogEditor) {
        mount.innerHTML = '<p class="text-sm" style="color:#ef4444;">에디터 로드 실패 — 새로고침 후 다시 시도</p>';
        return;
      }
      mount.innerHTML = '';
      _editor?.destroy?.();
      _editor = window.createBlogEditor({
        element: mount,
        initialMarkdown: post.content || '',
        apiBase: API_BASE,
        getAuthToken: () => localStorage.getItem('auth_token'),
      });
    });

    document.getElementById('edit-cover')?.addEventListener('input', event => {
      updateCoverPreview(event.target.value.trim());
    });
    setupCoverDropZone();
  }

  function waitForEditor(maxWaitMs = 8000) {
    return new Promise(resolve => {
      const start = Date.now();
      (function check() {
        if (window.createBlogEditor) return resolve(true);
        if (Date.now() - start > maxWaitMs) return resolve(false);
        setTimeout(check, 60);
      })();
    });
  }

  let _editor = null;

  function togglePrivateInput() {
    const checked = document.getElementById('edit-private')?.checked ?? false;
    const wrap = document.getElementById('edit-password-wrap');
    const pw = document.getElementById('edit-password');
    if (wrap) wrap.style.display = checked ? 'block' : 'none';
    if (pw && !checked) pw.value = '';
  }

  function pickCoverImage() {
    document.getElementById('edit-cover-file')?.click();
  }

  function setCoverUploadStatus(message, color = 'var(--color-text-secondary)') {
    const status = document.getElementById('edit-cover-status');
    if (!status) return;
    status.textContent = message;
    status.style.color = color;
  }

  function setCoverDropActive(active) {
    const zone = document.getElementById('edit-cover-dropzone');
    if (!zone) return;
    zone.style.borderColor = active ? 'var(--color-accent)' : 'var(--color-border)';
    zone.style.background = active ? 'rgba(63,185,80,0.10)' : 'rgba(63,185,80,0.03)';
  }

  function firstDroppedImage(dataTransfer) {
    const files = Array.from(dataTransfer?.files || []);
    return files.find(file => file.type?.startsWith('image/')) || null;
  }

  function hasDraggedFiles(dataTransfer) {
    return Array.from(dataTransfer?.types || []).includes('Files');
  }

  function setupCoverDropZone() {
    const zone = document.getElementById('edit-cover-dropzone');
    if (!zone) return;

    ['dragenter', 'dragover'].forEach(type => {
      zone.addEventListener(type, event => {
        if (!hasDraggedFiles(event.dataTransfer)) return;
        event.preventDefault();
        event.stopPropagation();
        setCoverDropActive(true);
        setCoverUploadStatus('놓으면 대표 이미지로 업로드됩니다.');
      });
    });

    ['dragleave', 'dragend'].forEach(type => {
      zone.addEventListener(type, event => {
        event.preventDefault();
        event.stopPropagation();
        setCoverDropActive(false);
      });
    });

    zone.addEventListener('drop', event => {
      if (!hasDraggedFiles(event.dataTransfer)) return;
      event.preventDefault();
      event.stopPropagation();
      setCoverDropActive(false);
      const file = firstDroppedImage(event.dataTransfer);
      if (!file) {
        setCoverUploadStatus('이미지 파일만 대표 이미지로 드롭할 수 있습니다.', '#ef4444');
        return;
      }
      uploadCoverImage(file);
    });
  }

  function updateCoverPreview(url) {
    const preview = document.getElementById('edit-cover-preview');
    const img = document.getElementById('edit-cover-img');
    if (!preview || !img) return;
    if (!url) {
      preview.style.display = 'none';
      img.removeAttribute('src');
      return;
    }
    img.src = url;
    preview.style.display = 'block';
  }

  function clearCoverImage() {
    const input = document.getElementById('edit-cover');
    if (input) input.value = '';
    updateCoverPreview('');
    setCoverUploadStatus('');
  }

  async function handleCoverFileSelected(event) {
    const input = event.target;
    const file = input?.files?.[0];
    if (!file) return;
    try {
      await uploadCoverImage(file);
    } finally {
      input.value = '';
    }
  }

  async function uploadCoverImage(file) {
    if (!file.type?.startsWith('image/')) {
      setCoverUploadStatus('이미지 파일만 첨부할 수 있습니다.', '#ef4444');
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      setCoverUploadStatus('대표 이미지는 5MB 이하만 첨부할 수 있습니다.', '#ef4444');
      return;
    }

    const token = localStorage.getItem('auth_token');
    if (!token) {
      setCoverUploadStatus('관리자 로그인 후 첨부할 수 있습니다.', '#ef4444');
      return;
    }

    const fd = new FormData();
    fd.append('file', file);
    setCoverUploadStatus('대표 이미지 업로드 중...');

    try {
      const res = await fetch(`${API_BASE}/api/upload`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 401 || res.status === 403) {
          clearStoredAuth();
          throw new Error('관리자 로그인이 만료되었거나 권한이 없습니다. 다시 로그인해주세요.');
        }
        throw new Error(data.error || `HTTP ${res.status}`);
      }
      if (!data.url) throw new Error('업로드 URL이 응답에 없습니다.');
      const coverInput = document.getElementById('edit-cover');
      if (coverInput) coverInput.value = data.url;
      updateCoverPreview(data.url);
      setCoverUploadStatus('대표 이미지가 첨부되었습니다.', '#3fb950');
    } catch (error) {
      setCoverUploadStatus(`업로드 실패: ${error.message || error}`, '#ef4444');
    }
  }

  let _previewTimer = null;
  function schedulePreview() {
    clearTimeout(_previewTimer);
    _previewTimer = setTimeout(() => {
      const content = document.getElementById('edit-content')?.value || '';
      const preview = document.getElementById('edit-preview');
      if (preview) { preview.innerHTML = renderContent(content); enrichLinkCards(preview); }
    }, 200);
  }

  function cancelEdit() {
    _editor?.destroy?.(); _editor = null;
    if (_isNewPost) {
      window.location.href = '/';
      return;
    }
    const commentsSection = document.getElementById('comments-section');
    if (commentsSection) commentsSection.style.display = '';
    loadPost();
  }

  async function saveEdit() {
    const btn = document.getElementById('edit-save-btn');
    const status = document.getElementById('edit-status');
    const title = document.getElementById('edit-title')?.innerText.trim();
    const description = document.getElementById('edit-desc')?.innerText.trim();
    const date = document.getElementById('edit-date')?.value;
    const category = document.getElementById('edit-category')?.value.trim();
    const tags = (document.getElementById('edit-tags')?.value || '').split(',').map(t => t.trim()).filter(Boolean);
    const draft = document.getElementById('edit-draft')?.checked ?? false;
    const cover = document.getElementById('edit-cover')?.value.trim() || '';
    const is_private = document.getElementById('edit-private')?.checked ?? false;
    const private_password = document.getElementById('edit-password')?.value || '';
    const content = (_editor ? _editor.getMarkdown() : '').trim();

    if (!title || !date || !category || !content) {
      status.textContent = '제목, 날짜, 카테고리, 내용은 필수입니다.';
      status.style.color = '#ef4444';
      return;
    }

    if (is_private && _isNewPost && !private_password) {
      status.textContent = '비공개 글은 암호를 설정해야 합니다.';
      status.style.color = '#ef4444';
      return;
    }

    btn.disabled = true; btn.textContent = '저장 중...';
    status.textContent = '';
    const token = localStorage.getItem('auth_token');

    const body = { title, description, date, category, tags, draft, cover, content, is_private };
    if (private_password) body.private_password = private_password;

    try {
      let res;
      if (_isNewPost) {
        res = await fetch(`${API_BASE}/api/posts`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        });
      } else {
        res = await fetch(`${API_BASE}/api/posts/${encodeURIComponent(_currentSlug)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        });
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 401 || res.status === 403) {
          clearStoredAuth();
          throw new Error('관리자 로그인이 만료되었거나 권한이 없습니다. 글 내용을 복사해 둔 뒤 다시 로그인해주세요.');
        }
        throw new Error(data.error || `HTTP ${res.status}`);
      }
      status.textContent = '저장됨!'; status.style.color = '#3fb950';
      _editor?.destroy?.(); _editor = null;
      if (_isNewPost && data.slug) {
        _isNewPost = false;
        _currentSlug = data.slug;
        setTimeout(() => {
          window.history.replaceState(null, '', postUrl(data.slug));
          const cs = document.getElementById('comments-section');
          if (cs) cs.style.display = '';
          loadPost();
        }, 700);
      } else {
        setTimeout(() => {
          const cs = document.getElementById('comments-section');
          if (cs) cs.style.display = '';
          loadPost();
        }, 700);
      }
    } catch (err) {
      status.textContent = '오류: ' + err.message; status.style.color = '#ef4444';
      btn.disabled = false; btn.textContent = '저장';
    }
  }

  async function adminDeleteCurrentPost() {
    if (!_currentSlug) return;
    if (!confirm(`"${_currentSlug}" 글을 삭제할까요?`)) return;
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/posts/${encodeURIComponent(_currentSlug)}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({}),
      });
      if (res.ok) {
        window.location.href = '/';
      } else {
        const d = await res.json();
        alert('삭제 실패: ' + (d.error || res.status));
      }
    } catch (e) {
      alert('오류: ' + e.message);
    }
  }

  window.addEventListener('hashchange', loadPost);
  applyStoredProfileAvatars();
  loadPost();
</script>

<script>
  import { createBlogEditor } from '../lib/editor';
  // expose to inline script (which calls window.createBlogEditor on Edit)
  (window as any).createBlogEditor = createBlogEditor;
</script>
