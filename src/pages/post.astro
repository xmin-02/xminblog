          ${(() => {
            try {
              const u = JSON.parse(localStorage.getItem('auth_user') || '{}');
              return u.role === 'admin' ? `
                <div class="flex items-center gap-2 mb-6">
                  <button onclick="enterEditMode()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors"
                    style="background:rgba(63,185,80,0.1);color:var(--color-accent);">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    편집
                  </button>
                  <button onclick="adminDeleteCurrentPost()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors"
                    style="background:rgba(239,68,68,0.08);color:#ef4444;">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    삭제
                  </button>
                </div>` : '';
            } catch { return ''; }
          })()}
          ${post.is_private ? `
            <div class="inline-flex items-center gap-1.5 mb-6 px-2.5 py-1 rounded-full text-xs font-medium"
              style="background:rgba(234,179,8,0.1);color:#ca8a04;border:1px solid rgba(234,179,8,0.3);font-family:var(--font-mono);">
              <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              비공개
            </div>` : ''}
          ${isLocked ? renderPasswordGate() : `<div class="prose prose-lg max-w-none" id="prose-content">${renderContent(post.content || '')}</div>`}

          ${isLocked ? '' : `
          <!-- Like button -->
          <div class="flex items-center gap-3 mt-10 pt-6 border-t border-[var(--color-border)]">
            <button id="like-btn" class="like-btn" onclick="handleLike()" aria-label="좋아요, 현재 0개" title="좋아요">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              0
            </button>
            <span class="text-xs text-[var(--color-text-secondary)]">이 글이 도움이 됐나요?</span>
          </div>

          ${navHtml}`}

          <div class="mt-10 pt-6 border-t border-[var(--color-border)]">
            <a href="/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              목록으로 돌아가기
            </a>
          </div>
        </article>
      `;

      // Wire up password gate (if locked)
      if (isLocked) {
        const pwForm = document.getElementById('pw-form');
        if (pwForm) pwForm.addEventListener('submit', submitPostPassword);
      }

      if (!isLocked) {
        // Build TOC
        const proseEl = document.getElementById('prose-content');
        if (proseEl) { buildToc(proseEl); enrichLinkCards(proseEl); }

        // Load likes
        await loadLikes(slug);

        // Record pageview (best-effort, deduped server-side per viewer/30min)
        recordPageview(slug);

        // Show comments section and load
        const commentsSection = document.getElementById('comments-section');
        if (commentsSection) {
          commentsSection.classList.remove('hidden');
          renderCommentForm(slug);
          await loadComments(slug);
        }
      }

      // Populate sidebar recent posts
      const recentEl = document.getElementById('sidebar-recent');
      if (recentEl && allPosts.length) {
        const recent = allPosts.filter(p => p.slug !== slug).slice(0, 5);
        recentEl.innerHTML = recent.map(p => {
          const d = p.date ? new Date(p.date).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' }) : '';
          return `<li><a href="${postUrl(p.slug)}" class="block group">
            <p class="text-xs font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-2 leading-snug">${esc(p.title)}</p>
            <p class="text-xs text-[var(--color-text-secondary)] mt-0.5">${esc(d)}</p>
          </a></li>`;
        }).join('');
      }

    } catch (err) {
      container.innerHTML = `
        <div class="text-center py-20 text-[var(--color-text-secondary)]">
          <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <p class="text-base font-medium mb-2">글을 찾을 수 없습니다.</p>
          <a href="/" class="text-sm text-[var(--color-accent)] hover:underline">홈으로 돌아가기</a>
        </div>`;
    }
  }

  // ── Private post gate ────────────────────────────────────────────────────

  function renderPasswordGate() {
    return `
      <div id="password-gate" class="my-8 py-12 px-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center">
        <svg width="36" height="36" class="mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" style="color:var(--color-accent);">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <h3 class="text-sm font-semibold mb-1.5" style="font-family:var(--font-display);">비공개 글</h3>
        <p class="text-xs text-[var(--color-text-secondary)] mb-5">이 글을 읽으려면 암호가 필요합니다.</p>
        <form id="pw-form" class="flex gap-2 max-w-xs mx-auto">
          <input id="pw-input" type="password" autocomplete="off" autofocus placeholder="암호"
            class="flex-1 px-3 py-2 rounded-md text-sm outline-none transition-colors"
            style="background:var(--color-bg-secondary);color:var(--color-text);border:1px solid var(--color-border);font-family:var(--font-mono);" />
          <button type="submit"
            class="px-4 py-2 rounded-md text-sm font-semibold transition-opacity"
            style="background:var(--color-accent);color:white;">확인</button>
        </form>
        <p id="pw-err" class="text-xs mt-3 hidden" style="color:#ef4444;"></p>
      </div>`;
  }

  async function verifyPostPassword(slug, password) {
    try {
      const res = await fetch(`${API_BASE}/api/posts/${encodeURIComponent(slug)}/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      if (res.ok) return await res.json();
    } catch {}
    return null;
  }

  async function submitPostPassword(e) {
    e.preventDefault();
    const input = document.getElementById('pw-input');
    const err = document.getElementById('pw-err');
    const pw = input?.value;
    if (!pw) return;
    err.classList.add('hidden');
    const unlocked = await verifyPostPassword(_currentSlug, pw);
    if (unlocked && unlocked.content != null) {
      sessionStorage.setItem(`post_pw_${_currentSlug}`, pw);
      _currentPost.content = unlocked.content;
      loadPost();
    } else {
      err.textContent = '암호가 올바르지 않습니다.';
      err.classList.remove('hidden');
      input.value = '';
      input.focus();
    }
  }

  // ── Inline editor ─────────────────────────────────────────────────────────

  // ── Toolbar definitions ───────────────────────────────────────────────────
  const TOOLBAR = [
    { label: '<b>B</b>',   title: '굵게',     wrap: ['**','**'] },
    { label: '<i>I</i>',   title: '기울임',   wrap: ['*','*'] },
    { label: '~~',         title: '취소선',   wrap: ['~~','~~'] },
    null, // separator
    { label: 'H1',  title: '제목 1', prefix: '# ' },
    { label: 'H2',  title: '제목 2', prefix: '## ' },
    { label: 'H3',  title: '제목 3', prefix: '### ' },
    null,
    { label: '<code style="font-size:10px">코드</code>', title: '인라인 코드', wrap: ['`','`'] },
    { label: '<code style="font-size:10px">```</code>',  title: '코드 블록', block: '```\n\n```', cursor: 4 },
    null,
    { label: '•',  title: '글머리 기호', prefix: '- ' },
    { label: '1.',  title: '번호 목록',   prefix: '1. ' },
    { label: '❝',  title: '인용',         prefix: '> ' },
    { label: '—',  title: '구분선',       block: '\n---\n' },
    null,
    { label: '🔗', title: '링크',  block: '[텍스트](URL)', sel: [1,3] },
    { label: '🖼️', title: '이미지', block: '![설명](URL)', sel: [2,4] },
    { label: '⊞',  title: '표',    block: '| 열1 | 열2 | 열3 |\n|---|---|---|\n| 내용 | 내용 | 내용 |' },
  ];

  function renderToolbar() {
    return TOOLBAR.map((btn, i) => {
      if (!btn) return '<div class="md-toolbar-sep"></div>';
      return `<button class="md-toolbar-btn" title="${btn.title}" onclick="insertMd(${i})">${btn.label}</button>`;
    }).join('');
  }

  function insertMd(idx) {
    const btn = TOOLBAR[idx];
    if (!btn) return;
    const ta = document.getElementById('edit-content');
    if (!ta) return;
    const start = ta.selectionStart, end = ta.selectionEnd;
    const sel = ta.value.substring(start, end);
    let insert = '';
    let cursorOffset = null;

    if (btn.wrap) {
      insert = btn.wrap[0] + (sel || btn.title) + btn.wrap[1];
      cursorOffset = start + insert.length;
    } else if (btn.prefix) {
      // Insert prefix at start of line
      const lineStart = ta.value.lastIndexOf('\n', start - 1) + 1;
      ta.value = ta.value.substring(0, lineStart) + btn.prefix + ta.value.substring(lineStart);
      ta.setSelectionRange(lineStart + btn.prefix.length, lineStart + btn.prefix.length);
      ta.focus(); schedulePreview(); autoResize(ta); return;
    } else if (btn.block) {
      insert = btn.block;
      cursorOffset = start + insert.length;
    }

    if (insert) {
      ta.value = ta.value.substring(0, start) + insert + ta.value.substring(end);
      ta.setSelectionRange(cursorOffset ?? start + insert.length, cursorOffset ?? start + insert.length);
    }
    ta.focus(); schedulePreview(); autoResize(ta);
  }

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = (el.scrollHeight + 2) + 'px';
  }

