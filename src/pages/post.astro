---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="xmin.blog">
  <div class="mx-auto max-w-6xl px-4 sm:px-5 py-8">
    <div class="flex gap-7 items-start">

      <!-- ===== ARTICLE AREA ===== -->
      <main class="flex-1 min-w-0">
        <div id="post-container">
          <div class="text-center py-20 text-[var(--color-text-secondary)]" id="post-loading">
            <div class="inline-block w-6 h-6 border-2 border-[var(--color-accent)] border-t-transparent rounded-full animate-spin mb-3"></div>
            <p class="text-sm">글을 불러오는 중...</p>
          </div>
        </div>

        <!-- Comments section (populated after post loads) -->
        <div id="comments-section" class="hidden mt-12 pt-8 border-t border-[var(--color-border)]">
          <h2 class="text-base font-bold mb-6" style="font-family:var(--font-display);color:var(--color-text);">댓글</h2>

          <!-- Comment form -->
          <div id="comment-form-area" class="mb-8"></div>

          <!-- Comment list -->
          <div id="comment-list" class="space-y-4"></div>
        </div>
      </main>

      <!-- ===== SIDEBAR ===== -->
      <aside class="w-64 shrink-0 hidden lg:block sticky top-20">

        <!-- Profile card -->
        <div class="sidebar-widget">
          <div class="flex flex-col items-center text-center py-2">
            <div id="sidebar-profile-avatar" class="w-14 h-14 rounded-full relative overflow-hidden flex items-center justify-center text-white text-lg font-bold mb-2.5" style="background: linear-gradient(135deg, #1f8c42, #11512a);">
              x
            </div>
            <p class="font-bold text-[var(--color-text)] text-sm">주수민 <span class="font-normal text-[var(--color-text-secondary)]">/ xmin</span></p>
            <p class="text-xs text-[var(--color-text-secondary)] mt-0.5">보안 · AI</p>
            <a href="/" class="mt-3 text-xs px-3 py-1.5 rounded-lg font-medium transition-colors" style="background:rgba(63,185,80,0.1);color:var(--color-accent);">
              글 목록 보기
            </a>
          </div>
        </div>

        <!-- Table of contents -->
        <div class="sidebar-widget" id="toc-widget" style="display:none;">
          <p class="sidebar-widget-title">목차</p>
          <nav id="toc-nav" class="space-y-1 text-xs"></nav>
        </div>

        <!-- Recent posts -->
        <div class="sidebar-widget">
          <p class="sidebar-widget-title">최근 글</p>
          <ul id="sidebar-recent" class="space-y-2.5">
            <li class="text-xs text-[var(--color-text-secondary)]">불러오는 중...</li>
          </ul>
        </div>

      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @keyframes spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: spin 0.8s linear infinite; }

  .post-nav-link {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 0.875rem 1rem; border-radius: 0.5rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s, transform 0.15s;
    text-decoration: none; color: inherit; flex: 1; min-width: 0;
  }
  .post-nav-link:hover { border-color: var(--color-accent); transform: translateY(-1px); }
  .post-nav-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-text-secondary); }
  .post-nav-title { font-size: 0.875rem; font-weight: 600; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.15s; }
  .post-nav-link:hover .post-nav-title { color: var(--color-accent); }

  .toc-link { display: block; padding: 0.2rem 0.5rem; border-radius: 0.35rem; color: var(--color-text-secondary); text-decoration: none; transition: color 0.15s, background-color 0.15s; line-height: 1.4; }
  .toc-link:hover, .toc-link.active { color: var(--color-accent); background-color: rgba(63,185,80,0.08); }
  .toc-h3 { padding-left: 1rem; font-size: 0.7rem; }
  .toc-h2 { font-size: 0.75rem; font-weight: 500; }

  /* ── Post cover banner ── */
  .post-cover {
    margin-bottom: 1.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
  }

  /* ── Inline editor ── */
  .edit-save-btn {
    padding: 0.375rem 1.25rem; border-radius: 0.5rem; border: none;
    background: var(--color-accent); color: white;
    font-size: 0.8125rem; font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  .edit-save-btn:hover { opacity: 0.88; }
  .edit-save-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .edit-cancel-btn {
    padding: 0.375rem 1rem; border-radius: 0.5rem;
    border: 1px solid var(--color-border); background: transparent;
    color: var(--color-text-secondary); font-size: 0.8125rem; cursor: pointer; transition: all 0.15s;
  }
  .edit-cancel-btn:hover { border-color: var(--color-text); color: var(--color-text); }
  [contenteditable="true"] {
    border-radius: 0.375rem;
    transition: outline 0.15s;
    outline: 2px solid transparent;
    outline-offset: 3px;
  }
  [contenteditable="true"]:focus { outline-color: var(--color-accent); }
  [contenteditable="true"][data-placeholder]:empty::before {
    content: attr(data-placeholder);
    color: var(--color-text-secondary);
    opacity: 0.45;
    pointer-events: none;
  }
  .edit-field-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.35rem;
    display: block;
  }
  .edit-field-label::before {
    content: '// ';
    color: var(--color-accent);
    opacity: 0.7;
  }
  .edit-required {
    color: #ef4444;
    margin-left: 0.2rem;
  }
  .edit-help-banner {
    background: rgba(63,185,80,0.06);
    border: 1px solid rgba(63,185,80,0.2);
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .edit-help-banner b { color: var(--color-text); font-weight: 600; }
  .md-toolbar {
    display: flex; flex-wrap: wrap; gap: 0.125rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--color-border); border-bottom: none;
    border-radius: 0.625rem 0.625rem 0 0;
    background: var(--color-bg-secondary);
  }
  .md-toolbar-btn {
    padding: 0.2rem 0.45rem; border-radius: 0.3rem; border: none;
    background: transparent; color: var(--color-text-secondary);
    font-size: 0.78rem; cursor: pointer; transition: all 0.12s;
    line-height: 1.4; min-width: 1.6rem; text-align: center;
  }
  .md-toolbar-btn:hover { background: var(--color-accent); color: #fff; }
  .md-toolbar-sep { width: 1px; background: var(--color-border); margin: 0.15rem 0.2rem; align-self: stretch; }
  .edit-body-textarea {
    width: 100%; padding: 1rem 1.125rem;
    border: 1px solid var(--color-border); border-radius: 0 0 0.625rem 0.625rem;
    background: var(--color-bg-secondary); color: var(--color-text);
    font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.8;
    resize: none; outline: none; overflow: hidden; min-height: 160px;
    transition: border-color 0.15s;
  }
  .edit-body-textarea:focus { border-color: var(--color-accent); }
  .edit-divider {
    display: flex; align-items: center; gap: 0.75rem; margin: 1.75rem 0 1.25rem;
    color: var(--color-text-secondary); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .edit-divider::before, .edit-divider::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }

  .like-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 2rem; font-size: 0.8125rem; font-weight: 600; border: 1.5px solid var(--color-border); background: var(--color-bg-card); color: var(--color-text-secondary); cursor: pointer; transition: all 0.15s; }
  .like-btn:hover { border-color: #f43f5e; color: #f43f5e; }
  .like-btn.liked { border-color: #f43f5e; color: #f43f5e; background: rgba(244,63,94,0.06); }

  /* ── Tiptap rich editor ── */
  .rich-editor {
    min-height: 360px;
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    font-size: 1.0125rem;
    line-height: 1.85;
    transition: border-color 0.15s;
    overflow: visible;
  }
  .rich-editor:focus-within { border-color: var(--color-accent); }
  .tt-editor-mount { padding: 1rem 1.25rem; }

  /* Table toolbar — sticky just below page header */
  .tt-table-toolbar {
    position: sticky;
    top: 56px;
    z-index: 25;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem;
    padding: 0.4rem 0.6rem;
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0.625rem 0.625rem 0 0;
    backdrop-filter: blur(8px);
  }
  .tt-tb-btn {
    padding: 0.3rem 0.55rem;
    border-radius: 0.35rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
    line-height: 1.2;
  }
  .tt-tb-btn:hover {
    background: rgba(63,185,80,0.12);
    color: var(--color-accent);
    border-color: rgba(63,185,80,0.3);
  }
  .tt-tb-sep {
    width: 1px; height: 1.1rem;
    background: var(--color-border);
    margin: 0 0.25rem;
  }

  /* Typography comes from the shared .prose (V11) styles so the editor renders
     live exactly like the published article. Only editor-specific chrome here. */
  .tiptap-editor-content { outline: none; min-height: 320px; }
  .tiptap-editor-content:focus { outline: none; }
  .tiptap-editor-content.prose { max-width: none; }
  .tiptap-editor-content p.is-editor-empty:first-child::before {
    content: attr(data-placeholder);
    color: var(--color-dim);
    float: left;
    pointer-events: none;
    height: 0;
  }
  .tiptap-editor-content h1.is-empty::before,
  .tiptap-editor-content h2.is-empty::before {
    content: attr(data-placeholder);
    color: var(--color-dim);
    float: left;
    pointer-events: none;
    height: 0;
  }
  /* table editing ergonomics */
  .tiptap-editor-content table { table-layout: fixed; }
  .tiptap-editor-content th, .tiptap-editor-content td { position: relative; }

  /* ── resizable image (drag the corner handle) ── */
  .tt-img-wrap {
    position: relative;
    display: inline-block;
    max-width: 100%;
    line-height: 0;
    margin: 0.6em 0;
  }
  .tt-img-wrap img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border-d);
    border-radius: 2px;
    filter: brightness(0.92);
  }
  .tt-img-wrap:hover img { filter: brightness(1); }
  .tt-img-handle {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 14px;
    height: 14px;
    background: var(--color-green);
    border: 2px solid var(--color-bg);
    border-radius: 3px;
    cursor: nwse-resize;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 2;
  }
  .tt-img-wrap:hover .tt-img-handle,
  .ProseMirror-selectednode .tt-img-handle { opacity: 1; }
  .tt-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: 2px;
    pointer-events: none;
    transition: border-color 0.15s;
  }
  .tt-img-wrap:hover::after { border-color: var(--color-green); }

  /* ── bubble toolbar (shown when text is selected) ── */
  .tt-bubble {
    position: fixed;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: var(--color-panel2);
    border: 1px solid var(--color-border-d);
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.5);
    font-family: var(--font-mono);
  }
  .tt-bubble-btn {
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    background: transparent;
    border: none;
    border-radius: 2px;
    color: var(--color-subtle);
    font-size: 12px;
    font-family: var(--font-mono);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.12s, color 0.12s;
  }
  .tt-bubble-btn:hover { background: var(--color-panel); color: var(--color-fg); }
  .tt-bubble-btn.is-active { color: var(--color-green); background: rgba(63,185,80,0.12); }
  .tt-bubble-sep { width: 1px; height: 16px; background: var(--color-border-d); margin: 0 3px; }
  .tt-bubble-swatch {
    width: 16px; height: 16px; border-radius: 50%;
    border: 1px solid var(--color-border-d); cursor: pointer;
    padding: 0; margin: 0 1px; transition: transform 0.1s;
  }
  .tt-bubble-swatch:hover { transform: scale(1.18); }
  .tiptap-editor-content .selectedCell::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(63,185,80,0.18); pointer-events: none;
  }
  .tiptap-editor-content .column-resize-handle {
    position: absolute; right: -2px; top: 0; bottom: 0; width: 4px;
    background: var(--color-accent); pointer-events: none;
  }

  /* Slash command menu */
  .slash-menu {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.3rem;
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    min-width: 220px;
    max-height: 280px;
    overflow-y: auto;
  }
  .slash-item {
    display: flex; gap: 0.6rem; align-items: center;
    width: 100%; text-align: left;
    padding: 0.45rem 0.65rem; border-radius: 0.35rem;
    background: transparent; border: none; cursor: pointer;
    font-size: 0.85rem; color: var(--color-text);
    transition: background 0.1s, color 0.1s;
  }
  .slash-item:hover, .slash-item.is-selected {
    background: rgba(63,185,80,0.12);
    color: var(--color-accent);
  }
  .slash-title { flex: 1; font-weight: 500; }
  .slash-sub { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-secondary); }
  .slash-empty { padding: 0.6rem 0.7rem; font-size: 0.8rem; color: var(--color-text-secondary); }

  /* Tippy reset */
  .tippy-box { background: transparent; border: none; padding: 0; }
  .tippy-box[data-theme] .tippy-content { padding: 0; }

  .comment-card { padding: 0.875rem 1rem; border-radius: 0.75rem; background: var(--color-bg-card); box-shadow: var(--shadow-card); }
  .comment-textarea { width: 100%; padding: 0.75rem; border-radius: 0.625rem; border: 1px solid var(--color-border); background: var(--color-bg-secondary); color: var(--color-text); font-size: 0.875rem; resize: vertical; min-height: 80px; font-family: var(--font-sans); transition: border-color 0.15s; outline: none; }
  .comment-textarea:focus { border-color: var(--color-accent); }
  .comment-submit { padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-size: 0.8125rem; font-weight: 600; color: white; border: none; cursor: pointer; transition: opacity 0.15s; background: linear-gradient(135deg, #1f8c42, #11512a); }
  .comment-submit:hover { opacity: 0.9; }
  .comment-submit:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script is:inline>
  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';
  let _currentPost = null;

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function safeUrl(raw, kind = 'link') {
    const value = String(raw ?? '').trim().replace(/&amp;/g, '&');
    if (!value) return '#';
    try {
      const parsed = new URL(value, window.location.origin);
      const allowed = kind === 'image'
        ? ['http:', 'https:']
        : ['http:', 'https:', 'mailto:', 'tel:'];
      if (!allowed.includes(parsed.protocol)) return '#';
      return esc(value);
    } catch {
      return '#';
    }
  }

  function profileImageSrc(raw) {
    const value = String(raw || '').trim();
    if (!value) return '';
    if (value.startsWith('/uploads/')) return `${API_BASE}${value}`;
    return value;
  }

  function profileAvatarHtml(avatarUrl, nickname, sizeClass = 'w-6 h-6') {
    const fallback = esc((nickname || '?')[0].toUpperCase());
    const src = profileImageSrc(avatarUrl);
    if (!src) {
      return `<span class="${sizeClass} rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="width:1.5rem;height:1.5rem;max-width:1.5rem;max-height:1.5rem;background:linear-gradient(135deg,#1f8c42,#11512a);">${fallback}</span>`;
    }
    return `<span class="${sizeClass} rounded-full relative overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="width:1.5rem;height:1.5rem;max-width:1.5rem;max-height:1.5rem;background:linear-gradient(135deg,#1f8c42,#11512a);">
      ${fallback}
      <img src="${safeUrl(src, 'image')}" alt="" style="position:absolute;inset:0;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;" loading="lazy" decoding="async" onerror="this.style.display='none';">
    </span>`;
  }

  function applyStoredProfileAvatars() {
    const raw = localStorage.getItem('auth_user');
    if (!raw) return;
    let user;
    try { user = JSON.parse(raw); } catch { return; }
    if (!user || user.role !== 'admin' || !user.avatar_url) return;

    const sidebarAvatar = document.getElementById('sidebar-profile-avatar');
    if (sidebarAvatar) {
      sidebarAvatar.textContent = 'x';
      const img = document.createElement('img');
      img.src = profileImageSrc(user.avatar_url);
      img.alt = '';
      img.className = 'absolute inset-0 w-full h-full object-cover';
      img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => { img.remove(); }, { once: true });
      sidebarAvatar.appendChild(img);
    }
  }

  function getViewerId() {
    let v = localStorage.getItem('viewer_id');
    if (!v) {
      v = (crypto?.randomUUID && crypto.randomUUID()) ||
          ('v_' + Math.random().toString(36).slice(2) + Date.now().toString(36));
      localStorage.setItem('viewer_id', v);
    }
    return v;
  }

  function recordPageview(slug) {
    fetch(`${API_BASE}/api/views/${encodeURIComponent(slug)}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ viewer_id: getViewerId(), referrer: document.referrer || '' }),
      keepalive: true,
    }).catch(() => {});
  }

  function renderMarkdown(md) {
    let html = md.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

    // Code blocks first so their content is preserved verbatim
    html = html.replace(/```(\w*)\n([\s\S]*?)```/g, (_, lang, code) =>
      `\n\n<pre><code class="language-${lang || 'text'}">${code.trimEnd()}</code></pre>\n\n`);
    html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

    // Inline media/links
    html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (_, alt, url) =>
      `<img src="${safeUrl(url, 'image')}" alt="${esc(alt)}" />`);
    html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, url) =>
      `<a href="${safeUrl(url)}" target="_blank" rel="noopener">${label}</a>`);

    // Headings — wrap with blank lines so each becomes its own block
    html = html.replace(/^#### (.+)$/gm, '\n\n<h4>$1</h4>\n\n');
    html = html.replace(/^### (.+)$/gm, '\n\n<h3>$1</h3>\n\n');
    html = html.replace(/^## (.+)$/gm, '\n\n<h2>$1</h2>\n\n');
    html = html.replace(/^# (.+)$/gm, '\n\n<h1>$1</h1>\n\n');

    // Inline emphasis
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');

    // Blockquote / hr — also block-level
    html = html.replace(/^&gt; (.+)$/gm, '\n\n<blockquote>$1</blockquote>\n\n');
    html = html.replace(/^---$/gm, '\n\n<hr>\n\n');

    return html.split(/\n{2,}/).map(block => {
      const t = block.trim();
      if (!t) return '';
      if (/^<(h[1-6]|pre|blockquote|hr|img)/.test(t)) return t;

      const lines = t.split('\n');

      // GFM table: header row + |---|---| separator + body rows
      if (lines.length >= 2 && lines[0].trim().startsWith('|') && /^\s*\|?[\s|:\-]+\|[\s|:\-]*$/.test(lines[1].trim())) {
        const rows = lines.filter(l => l.trim().startsWith('|'));
        const splitRow = (r) => r.trim().replace(/^\||\|$/g, '').split('|').map(c => c.trim());
        const header = splitRow(rows[0]);
        const body = rows.slice(2).map(splitRow);
        let out = '<table><thead><tr>';
        for (const h of header) out += `<th>${h}</th>`;
        out += '</tr></thead><tbody>';
        for (const cells of body) {
          out += '<tr>' + cells.map(c => `<td>${c}</td>`).join('') + '</tr>';
        }
        out += '</tbody></table>';
        return out;
      }

      // Unordered list
      if (lines.every(l => /^[-*] /.test(l) || !l.trim())) {
        return '<ul>' + lines.map(l => { const m = l.match(/^[-*] (.+)/); return m ? `<li>${m[1]}</li>` : ''; }).join('') + '</ul>';
      }
      // Ordered list
      if (lines.every(l => /^\d+\. /.test(l) || !l.trim())) {
        return '<ol>' + lines.map(l => { const m = l.match(/^\d+\. (.+)/); return m ? `<li>${m[1]}</li>` : ''; }).join('') + '</ol>';
      }

      return '<p>' + t.replace(/\n/g, '<br>') + '</p>';
    }).join('\n');
  }

  // Body may be HTML (new editor: alignment/color) or legacy Markdown.
  function isHtmlContent(s) {
    return /^\s*<(p|h[1-6]|ul|ol|blockquote|pre|table|figure|div|hr|img|span)[\s>]/i.test(s || '');
  }

  // Sanitize admin-authored HTML and wrap images in the terminal frame.
  function sanitizeAndFrame(html) {
    const root = document.createElement('div');
    root.innerHTML = html;
    root.querySelectorAll('script, style, iframe, object, embed, link, meta, form, input, button, svg').forEach(n => n.remove());
    root.querySelectorAll('*').forEach(el => {
      Array.from(el.attributes).forEach(attr => {
        const name = attr.name.toLowerCase();
        const val = attr.value || '';
        if (name.startsWith('on')) el.removeAttribute(attr.name);
        else if ((name === 'href' || name === 'src') && /^\s*(javascript|vbscript|data):/i.test(val)) el.removeAttribute(attr.name);
        else if (name === 'style' && /(expression|url\s*\(|position\s*:|@import|fixed)/i.test(val)) el.removeAttribute(attr.name);
      });
    });
    root.querySelectorAll('img').forEach(img => {
      if (img.closest('.imgframe')) return;
      const src = img.getAttribute('src') || '';
      const alt = img.getAttribute('alt') || '';
      const wRaw = img.getAttribute('width') || (img.style && img.style.width) || '';
      const w = parseInt(wRaw, 10);
      let file = src.split('/').pop() || 'image';
      try { file = decodeURIComponent(file.split('?')[0]); } catch {}
      let fmt = (src.split('.').pop() || 'img').split('?')[0].toLowerCase();
      if (fmt.length > 5) fmt = 'img';
      const fig = document.createElement('figure');
      fig.className = 'figure';
      const frame = document.createElement('div');
      frame.className = 'imgframe';
      if (w) frame.style.maxWidth = w + 'px';
      frame.innerHTML = `<div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="file">${esc(file)}</span><span class="meta">${esc(fmt)}<span data-res hidden></span></span></div>`;
      const ni = document.createElement('img');
      ni.className = 'img'; ni.src = src; ni.alt = alt; ni.loading = 'lazy'; ni.decoding = 'async';
      frame.appendChild(ni);
      fig.appendChild(frame);
      if (alt) { const cap = document.createElement('figcaption'); cap.textContent = alt; fig.appendChild(cap); }
      const p = img.parentElement;
      if (p && p.tagName === 'P' && p.children.length === 1 && !(p.textContent || '').trim()) p.replaceWith(fig);
      else img.replaceWith(fig);
    });
    return root.innerHTML;
  }

  function renderContent(content) {
    const s = String(content || '');
    const html = isHtmlContent(s) ? sanitizeAndFrame(s) : renderMarkdown(s);
    // Turn standalone links into bookmark cards (enriched after injection).
    const root = document.createElement('div');
    root.innerHTML = html;
    cardifyLinks(root);
    return root.innerHTML;
  }

  function buildCardHtml(url) {
    let host = '', path = '';
    try { const u = new URL(url); host = u.hostname.replace(/^www\./, ''); path = decodeURIComponent(u.pathname).replace(/^\/|\/$/g, ''); }
    catch { return null; }
    const fav = `https://www.google.com/s2/favicons?sz=64&domain=${encodeURIComponent(host)}`;
    const title = path ? esc(path) : esc(host);
    return `<a class="link-card" href="${esc(url)}" target="_blank" rel="noopener" data-lc="${esc(url)}">
      <div class="lc-body">
        <div class="lc-title">${title}</div>
        <div class="lc-desc"></div>
        <div class="lc-host"><img class="lc-fav" src="${fav}" alt="" loading="lazy"/> ${esc(host)}</div>
      </div>
      <div class="lc-thumb"></div>
    </a>`;
  }

  function cardifyLinks(root) {
    root.querySelectorAll('p').forEach(p => {
      const a = p.querySelector('a');
      if (!a) return;
      if (p.children.length !== 1 || p.firstElementChild !== a) return;
      if ((p.textContent || '').trim() !== (a.textContent || '').trim()) return; // inline links stay
      const url = a.getAttribute('href') || '';
      if (!/^https?:\/\//i.test(url)) return;
      const html = buildCardHtml(url);
      if (!html) return;
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      p.replaceWith(tmp.firstElementChild);
    });
  }

  function fmtNum(n) { n = +n || 0; return n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1) + 'k' : String(n); }

  async function enrichGitHubCard(card, owner, repo) {
    try {
      const r = await fetch(`https://api.github.com/repos/${owner}/${repo}`);
      if (!r.ok) return;
      const d = await r.json();
      const t = card.querySelector('.lc-title'); if (t) t.textContent = d.full_name || `${owner}/${repo}`;
      const desc = card.querySelector('.lc-desc'); if (desc && d.description) desc.textContent = d.description;
      const thumb = card.querySelector('.lc-thumb');
      if (thumb && d.owner && d.owner.avatar_url) thumb.style.backgroundImage = `url(${d.owner.avatar_url})`;
      const body = card.querySelector('.lc-body');
      if (body && !body.querySelector('.lc-meta')) {
        const meta = document.createElement('div');
        meta.className = 'lc-meta';
        meta.textContent = `★ ${fmtNum(d.stargazers_count)}   ⑂ ${fmtNum(d.forks_count)}${d.language ? '   ' + d.language : ''}`;
        body.insertBefore(meta, body.querySelector('.lc-host'));
      }
    } catch {}
  }

  function enrichLinkCards(scope) {
    (scope || document).querySelectorAll('.link-card[data-lc]').forEach(card => {
      const url = card.getAttribute('data-lc');
      card.removeAttribute('data-lc');
      let u; try { u = new URL(url); } catch { return; }
      const host = u.hostname.replace(/^www\./, '');
      const gh = host === 'github.com' && u.pathname.match(/^\/([^/]+)\/([^/]+)\/?$/);
      if (gh) { enrichGitHubCard(card, gh[1], gh[2]); return; }
      let ytId = null;
      if (host.endsWith('youtube.com')) ytId = new URLSearchParams(u.search).get('v');
      else if (host === 'youtu.be') ytId = u.pathname.slice(1);
      if (ytId) {
        const thumb = card.querySelector('.lc-thumb');
        if (thumb) thumb.style.backgroundImage = `url(https://i.ytimg.com/vi/${ytId}/hqdefault.jpg)`;
        const t = card.querySelector('.lc-title'); if (t && t.textContent.length < 3) t.textContent = 'YouTube';
      }
    });
  }

  function buildToc(container) {
    const headings = container.querySelectorAll('h2, h3');
    const tocWidget = document.getElementById('toc-widget');
    const tocNav = document.getElementById('toc-nav');
    if (!tocWidget || !tocNav) return;
    tocNav.innerHTML = '';
    tocWidget.style.display = 'none';
    if (headings.length < 2) return;
    tocWidget.style.display = '';
    let idCounter = 0;
    const links = [];
    headings.forEach(h => {
      const id = `heading-${++idCounter}`;
      h.id = id;
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.className = `toc-link ${h.tagName === 'H3' ? 'toc-h3' : 'toc-h2'}`;
      a.textContent = h.textContent;
      tocNav.appendChild(a);
      links.push({ el: h, a });
    });
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const link = links.find(l => l.el === entry.target);
        if (link) link.a.classList.toggle('active', entry.isIntersecting);
      });
    }, { rootMargin: '-10% 0px -80% 0px' });
    headings.forEach(h => obs.observe(h));
  }

  function clearStoredAuth() {
    localStorage.removeItem('auth_token');
    localStorage.removeItem('auth_user');
  }

  async function refreshStoredUser() {
    const token = localStorage.getItem('auth_token');
    if (!token) return null;
    try {
      const res = await fetch(`${API_BASE}/api/auth/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.status === 401 || res.status === 403) {
        clearStoredAuth();
        return null;
      }
      if (!res.ok) return null;
      const user = await res.json();
      localStorage.setItem('auth_user', JSON.stringify(user));
      applyStoredProfileAvatars();
      return user;
    } catch {
      return null;
    }
  }

  function showAdminAuthRequired(message = '관리자 로그인이 필요합니다.') {
    const container = document.getElementById('post-container');
    if (!container) return;
    container.innerHTML = `
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] px-5 py-8 text-center">
        <p class="text-base font-semibold mb-2" style="color:var(--color-text);">관리자 인증 필요</p>
        <p class="text-sm mb-5" style="color:var(--color-text-secondary);">${esc(message)}</p>
        <a href="/login" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold"
          style="background:var(--color-accent);color:white;">다시 로그인</a>
      </div>`;
  }

  async function requireAdminForEdit() {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      showAdminAuthRequired('새 글 작성과 편집은 관리자 계정으로 로그인한 뒤 사용할 수 있습니다.');
      return false;
    }

    try {
      const res = await fetch(`${API_BASE}/api/auth/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.status === 401 || res.status === 403) {
        clearStoredAuth();
        showAdminAuthRequired('로그인이 만료되었거나 관리자 권한이 확인되지 않습니다. 다시 로그인해주세요.');
        return false;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const user = await res.json();
      localStorage.setItem('auth_user', JSON.stringify(user));
      if (user.role !== 'admin') {
        showAdminAuthRequired('현재 계정은 관리자 권한이 없어 글 작성과 이미지 업로드를 사용할 수 없습니다.');
        return false;
      }
      return true;
    } catch {
      showAdminAuthRequired('관리자 인증 상태를 확인하지 못했습니다. 네트워크 상태를 확인한 뒤 다시 시도해주세요.');
      return false;
    }
  }

  // ── Likes ─────────────────────────────────────────────────────────────────

  let _likeCount = 0;
  let _liked = false;
  let _currentSlug = '';

  async function loadLikes(slug) {
    const token = localStorage.getItem('auth_token');
    const headers = token ? { Authorization: `Bearer ${token}` } : {};
    try {
      const res = await fetch(`${API_BASE}/api/likes/${encodeURIComponent(slug)}`, { headers });
      if (res.ok) {
        const data = await res.json();
        _likeCount = data.count;
        _liked = data.liked;
        renderLikeBtn();
      }
    } catch {}
  }

  function renderLikeBtn() {
    const btn = document.getElementById('like-btn');
    if (!btn) return;
    btn.className = `like-btn${_liked ? ' liked' : ''}`;
    btn.setAttribute('aria-label', _liked ? `좋아요 취소, 현재 ${_likeCount}개` : `좋아요, 현재 ${_likeCount}개`);
    btn.title = _liked ? '좋아요 취소' : '좋아요';
    btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="${_liked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg> ${_likeCount}`;
  }

  async function handleLike() {
    const token = localStorage.getItem('auth_token');
    if (!token) { window.location.href = '/login'; return; }
    try {
      const res = await fetch(`${API_BASE}/api/likes/${encodeURIComponent(_currentSlug)}`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        _likeCount = data.count;
        _liked = data.liked;
        renderLikeBtn();
      } else if (res.status === 401) {
        localStorage.removeItem('auth_token');
        localStorage.removeItem('auth_user');
        window.location.href = '/login';
      } else {
        let message = '좋아요 처리에 실패했습니다.';
        try {
          const data = await res.json();
          if (data?.error) message += ` (${data.error})`;
        } catch {}
        alert(message);
      }
    } catch {
      alert('좋아요 처리에 실패했습니다. 네트워크 상태를 확인해주세요.');
    }
  }

  // ── Comments ──────────────────────────────────────────────────────────────

  async function loadComments(slug) {
    const commentList = document.getElementById('comment-list');
    if (!commentList) return;
    try {
      const res = await fetch(`${API_BASE}/api/comments/${encodeURIComponent(slug)}`);
      if (!res.ok) return;
      const comments = await res.json();

      const token = localStorage.getItem('auth_token');
      let currentUserId = null;
      let currentRole = null;
      const userRaw = localStorage.getItem('auth_user');
      if (userRaw) {
        try { const u = JSON.parse(userRaw); currentUserId = u.id; currentRole = u.role; } catch {}
      }

      if (comments.length === 0) {
        commentList.innerHTML = '<p class="text-xs text-[var(--color-text-secondary)] text-center py-4">아직 댓글이 없습니다. 첫 댓글을 남겨보세요!</p>';
      } else {
        commentList.innerHTML = comments.map(c => {
          const date = new Date(c.created_at * 1000).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });
          const canDelete = currentRole === 'admin' || currentUserId === c.user_id;
          const avatar = profileAvatarHtml(c.avatar_url, c.nickname);
          return `<div class="comment-card" id="comment-${c.id}">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2 mb-1.5">
                ${avatar}
                <span class="text-xs font-semibold text-[var(--color-text)]">${esc(c.nickname || '익명')}</span>
                <span class="text-xs text-[var(--color-text-secondary)]">${esc(date)}</span>
              </div>
              ${canDelete ? `<button onclick="deleteComment(${c.id})" class="text-xs text-[var(--color-text-secondary)] hover:text-red-500 transition-colors flex-shrink-0">삭제</button>` : ''}
            </div>
            <p class="text-sm text-[var(--color-text)] leading-relaxed">${esc(c.content)}</p>
          </div>`;
        }).join('');
      }
    } catch {}
  }

  function renderCommentForm(slug) {
    const area = document.getElementById('comment-form-area');
    if (!area) return;
    const token = localStorage.getItem('auth_token');
    const userRaw = localStorage.getItem('auth_user');
    let nickname = '';
    let avatarUrl = '';
    if (userRaw) {
      try {
        const user = JSON.parse(userRaw);
        nickname = user.nickname || '';
        avatarUrl = user.avatar_url || '';
      } catch {}
    }

    if (!token) {
      area.innerHTML = `<div class="rounded-xl border border-[var(--color-border)] px-4 py-3 text-sm text-[var(--color-text-secondary)]">
        <a href="/login" class="text-[var(--color-accent)] hover:underline font-medium">로그인</a>하면 댓글을 남길 수 있습니다.
      </div>`;
      return;
    }

    area.innerHTML = `<div class="space-y-2">
      <div class="flex items-center gap-2 mb-2">
        ${profileAvatarHtml(avatarUrl, nickname)}
        <span class="text-xs font-semibold text-[var(--color-text)]">${esc(nickname)}</span>
      </div>
      <textarea id="comment-input" class="comment-textarea" placeholder="댓글을 입력하세요..." maxlength="1000"></textarea>
      <div class="flex items-center justify-between">
        <span class="text-xs text-[var(--color-text-secondary)]"><span id="comment-char">0</span>/1000</span>
        <button id="comment-btn" class="comment-submit" onclick="submitComment('${slug}')" disabled>등록</button>
      </div>
    </div>`;

    document.getElementById('comment-input').addEventListener('input', updateCommentSubmitState);
    updateCommentSubmitState();
  }

  function updateCommentSubmitState() {
    const input = document.getElementById('comment-input');
    const btn = document.getElementById('comment-btn');
    const char = document.getElementById('comment-char');
    const value = input?.value || '';
    if (char) char.textContent = value.length;
    if (btn) btn.disabled = !value.trim();
  }

  async function submitComment(slug) {
    const input = document.getElementById('comment-input');
    const btn = document.getElementById('comment-btn');
    const content = input?.value?.trim();
    if (!content) {
      updateCommentSubmitState();
      return;
    }
    btn.disabled = true;
    btn.textContent = '등록 중...';
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/comments/${encodeURIComponent(slug)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ content }),
      });
      if (res.ok) {
        input.value = '';
        updateCommentSubmitState();
        await loadComments(slug);
      } else if (res.status === 401) {
        localStorage.removeItem('auth_token');
        localStorage.removeItem('auth_user');
        window.location.href = '/login';
      } else {
        let message = '댓글 등록에 실패했습니다.';
        try {
          const data = await res.json();
          if (data?.error) message += ` (${data.error})`;
        } catch {}
        alert(message);
      }
    } catch {
      alert('댓글 등록에 실패했습니다. 네트워크 상태를 확인해주세요.');
    }
    btn.disabled = false;
    btn.textContent = '등록';
    updateCommentSubmitState();
  }

  async function deleteComment(id) {
    if (!confirm('댓글을 삭제할까요?')) return;
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/comments/id/${id}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        document.getElementById(`comment-${id}`)?.remove();
        const list = document.getElementById('comment-list');
        if (list && !list.querySelector('[id^="comment-"]')) {
          list.innerHTML = '<p class="text-xs text-[var(--color-text-secondary)] text-center py-4">아직 댓글이 없습니다. 첫 댓글을 남겨보세요!</p>';
        }
      }
    } catch {}
  }

  // ── Main load ─────────────────────────────────────────────────────────────

  let _isNewPost = false;

  function postUrl(slug) {
    return `/post/?slug=${encodeURIComponent(slug)}`;
  }

  async function populateRecentSidebar(excludeSlug) {
    const recentEl = document.getElementById('sidebar-recent');
    if (!recentEl) return;
    try {
      const token = localStorage.getItem('auth_token');
      const res = await fetch(`${API_BASE}/api/posts`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
      if (!res.ok) throw new Error('api');
      const posts = (await res.json())
        .filter(p => !p.draft && !p.is_private && p.slug !== excludeSlug)
        .slice(0, 5);
      if (!posts.length) {
        recentEl.innerHTML = '<li class="text-xs text-[var(--color-text-secondary)]">아직 글이 없습니다.</li>';
        return;
      }
      recentEl.innerHTML = posts.map(p => {
        const d = p.date ? new Date(p.date).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' }) : '';
        return `<li><a href="${postUrl(p.slug)}" class="block group">
          <p class="text-xs font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-2 leading-snug">${esc(p.title)}</p>
          <p class="text-xs text-[var(--color-text-secondary)] mt-0.5">${esc(d)}</p>
        </a></li>`;
      }).join('');
    } catch {
      recentEl.innerHTML = '<li class="text-xs text-[var(--color-text-secondary)]">불러오기 실패</li>';
    }
  }

  function readRouteSlug() {
    const hashSlug = window.location.hash ? decodeURIComponent(window.location.hash.slice(1)) : '';
    if (hashSlug === 'new') return 'new';
    const querySlug = new URLSearchParams(window.location.search).get('slug') || '';
    return querySlug || hashSlug;
  }

  async function loadPost() {
    applyStoredProfileAvatars();
    await refreshStoredUser();
    const slug = readRouteSlug();
    if (!slug) { window.location.href = '/'; return; }

    const container = document.getElementById('post-container');
    const commentsSection = document.getElementById('comments-section');
    const tocWidget = document.getElementById('toc-widget');
    const tocNav = document.getElementById('toc-nav');
    if (tocWidget) tocWidget.style.display = 'none';
    if (tocNav) tocNav.innerHTML = '';
    if (commentsSection) commentsSection.classList.add('hidden');
    document.getElementById('comment-form-area')?.replaceChildren();
    document.getElementById('comment-list')?.replaceChildren();
    container.innerHTML = `
      <div class="text-center py-20 text-[var(--color-text-secondary)]" id="post-loading">
        <div class="inline-block w-6 h-6 border-2 border-[var(--color-accent)] border-t-transparent rounded-full animate-spin mb-3"></div>
        <p class="text-sm">글을 불러오는 중...</p>
      </div>`;

    if (slug === 'new') {
      if (!(await requireAdminForEdit())) return;
      _isNewPost = true;
      _currentSlug = '';
      _currentPost = { title: '', description: '', content: '', category: '', tags: [], date: new Date().toISOString().slice(0, 10), draft: false, cover: '', is_private: false };
      document.title = '새 글 작성 — xmin.blog';
      container.innerHTML = '<article></article>';
      if (commentsSection) commentsSection.style.display = 'none';
      populateRecentSidebar('');
      await enterEditMode(true);
      return;
    }

    _isNewPost = false;
    _currentSlug = slug;

    try {
      const token = localStorage.getItem('auth_token');
      const authHeaders = token ? { Authorization: `Bearer ${token}` } : {};
      const [postRes, allRes] = await Promise.all([
        fetch(`${API_BASE}/api/posts/${encodeURIComponent(slug)}`, { headers: authHeaders }),
        fetch(`${API_BASE}/api/posts`, { headers: authHeaders }),
      ]);

      if (!postRes.ok) throw new Error('Post not found');
      const post = await postRes.json();
      _currentPost = post;
      const allPosts = allRes.ok ? (await allRes.json()).filter(p => !p.draft && !p.is_private) : [];

      // Private post: try cached password first
      if (post.is_private && post.content == null) {
        const cached = sessionStorage.getItem(`post_pw_${slug}`);
        if (cached) {
          const unlocked = await verifyPostPassword(slug, cached);
          if (unlocked) {
            post.content = unlocked.content;
            _currentPost.content = unlocked.content;
          } else {
            sessionStorage.removeItem(`post_pw_${slug}`);
          }
        }
      }
      const isLocked = post.is_private && post.content == null;

      document.title = `${post.title} — xmin.blog`;

      const date = post.date
        ? new Date(post.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })
        : '';

      const tags = (post.tags || []).map(t =>
        `<span class="px-2.5 py-1 rounded-full text-xs text-[var(--color-text-secondary)] bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">${esc(t)}</span>`
      ).join('');

      const idx = allPosts.findIndex(p => p.slug === slug);
      const prev = idx > 0 ? allPosts[idx - 1] : null;
      const next = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;

      const navHtml = (prev || next) ? `
        <div class="flex gap-3 mt-12">
          ${prev ? `<a href="${postUrl(prev.slug)}" class="post-nav-link"><span class="post-nav-label">← 이전 글</span><span class="post-nav-title">${esc(prev.title)}</span></a>` : '<div class="flex-1"></div>'}
          ${next ? `<a href="${postUrl(next.slug)}" class="post-nav-link" style="text-align:right;"><span class="post-nav-label">다음 글 →</span><span class="post-nav-title">${esc(next.title)}</span></a>` : '<div class="flex-1"></div>'}
        </div>` : '';

      container.innerHTML = `
        <article>
          ${post.cover ? `<div class="post-cover"><img src="${esc(post.cover)}" alt="${esc(post.title)}" loading="eager" /></div>` : ''}
          <header class="mb-10 pb-8 border-b border-[var(--color-border)]">
            <div class="flex flex-wrap items-center gap-2 mb-4" style="font-family: var(--font-mono);">
              ${post.category ? `<a href="/?category=${encodeURIComponent(post.category)}" class="text-xs font-medium transition-colors" style="color:var(--color-accent);">[${esc(post.category)}]</a>` : ''}
              <span class="text-xs text-[var(--color-text-secondary)]">${esc(date)}</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold leading-snug mb-4 tracking-tight" style="font-family:var(--font-display);color:var(--color-text);">${esc(post.title)}</h1>
            <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">${esc(post.description)}</p>
            ${tags ? `<div class="flex flex-wrap gap-2 mt-4">${tags}</div>` : ''}
