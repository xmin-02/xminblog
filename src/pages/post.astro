          </div>
        </div>

        <!-- Title (required) -->
        <label class="edit-field-label">제목<span class="edit-required">*</span></label>
        <h1 id="edit-title" contenteditable="true" spellcheck="false"
          data-placeholder="여기에 제목을 입력하세요"
