---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="CVE Research — xmin.blog"
  description="신규 CVE와 취약점 리서치를 추적하는 xmin.blog 채널"
  active={3}
  path="cve"
  maxWidth={960}
>
  <section class="v11-channel">
    <div class="v11-dim v11-channel-cmd"><span class="v11-gr">$</span> tail -f feeds/cve-research.log</div>
    <h1 class="v11-sans v11-channel-title"><span class="v11-gr">CVE</span> Research</h1>
    <p class="v11-sans v11-channel-copy">
      신규 CVE와 공개 익스플로잇, 벤더 어드바이저리를 추적하는 공간입니다. 자동 수집은 초안으로 만들고,
      중요도와 재현 가능성을 검토한 뒤 게시하는 흐름으로 운영할 예정입니다.
    </p>

    <div class="v11-channel-panel">
      <div class="v11-channel-panel-head">
        <span><span class="v11-gr">$</span> ls posts/ --category "CVE Research"</span>
        <span class="v11-dim" id="cve-count">syncing…</span>
      </div>
      <div id="cve-posts">
        <div class="v11-dim v11-channel-empty">CVE Research 글을 불러오는 중…<span class="v11-cursor"></span></div>
      </div>
      <div id="cve-pagination"></div>
    </div>

    <div class="v11-channel-notes">
      <span class="lvl lvl-ok">src</span> NVD · CVE.org · CISA KEV · vendor advisories
      <span class="v11-dim">/ filters: severity · exploitability · affected stack</span>
    </div>
  </section>
</Layout>

<script>
  import { bindPagination, paginate, paginationHtml } from '../../lib/pagination';

  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';
  const PAGE_SIZE = 10;
  const wantedTags = ['cve', 'cves'];
  const cveIdPattern = /\bCVE-\d{4}-\d{4,}\b/i;
  let activePage = Number.parseInt(new URLSearchParams(location.search).get('page') || '1', 10) || 1;
  let channelPosts = [];

  function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function postUrl(slug){return `/post/${encodeURIComponent(slug)}/`;}
  function fmtDate(d){try{return new Date(d).toISOString().slice(0,10);}catch{return'';}}
  function displayTitle(title){return String(title||'').replace(/^\[CVE\]\s*/i, '[CVE Research] ');}
  function syncPageUrl(page){
    const next = new URLSearchParams();
    if(page > 1) next.set('page', String(page));
    const qs = next.toString();
    history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
  }
  function hasWantedTag(post){
    const category = String(post.category || '').trim().toLowerCase();
    const source = String(post.source_type || '').trim().toLowerCase();
    const tags = (post.tags || []).map((tag) => String(tag).toLowerCase());
    const title = String(post.title || '').toLowerCase();
    return category === 'cve research'
      || category === 'cve'
      || source === 'cve'
      || wantedTags.some((tag) => tags.includes(tag))
      || cveIdPattern.test(title);
  }
  function render(){
    const list = document.getElementById('cve-posts');
    const count = document.getElementById('cve-count');
    const pageState = paginate(channelPosts, activePage, PAGE_SIZE);
    activePage = pageState.page;
    count.textContent = `${pageState.total} entries · page ${pageState.page}/${pageState.pageCount}`;
    if (!channelPosts.length) {
      list.innerHTML = '<div class="v11-dim v11-channel-empty">아직 CVE Research 채널 글이 없습니다. 자동화 초안 파이프라인을 붙이면 여기에 모입니다.</div>';
      document.getElementById('cve-pagination').innerHTML = '';
      return;
    }
    list.innerHTML = pageState.items.map((post) => `<a class="v11-channel-row" href="${postUrl(post.slug)}">
      <span class="v11-dim">${esc(fmtDate(post.date))}</span>
      <span>
        <span class="v11-channel-row-title">${esc(displayTitle(post.title))}</span>
        ${post.description ? `<span class="v11-channel-row-desc">${esc(post.description)}</span>` : ''}
      </span>
      <span class="v11-dim">${(post.tags || []).slice(0, 2).map((tag) => `#${esc(tag)}`).join(' ')}</span>
    </a>`).join('');
    const pager=document.getElementById('cve-pagination');
    if(pager){
      pager.innerHTML=paginationHtml(pageState);
      bindPagination(pager, (page)=>{
        activePage=page;
        syncPageUrl(activePage);
        render();
        document.querySelector('.v11-channel-panel')?.scrollIntoView({block:'start'});
      });
    }
  }
  async function load(){
    try {
      const response = await fetch(`${API_BASE}/api/posts`);
      if (!response.ok) throw new Error('load failed');
      const posts = await response.json();
      channelPosts = posts.filter(hasWantedTag).sort((a,b)=>new Date(b.date)-new Date(a.date));
      render();
    } catch {
      document.getElementById('cve-count').textContent = 'offline';
      document.getElementById('cve-posts').innerHTML = '<div class="v11-dim v11-channel-empty">포스트 API를 불러오지 못했습니다.</div>';
      document.getElementById('cve-pagination').innerHTML = '';
    }
  }
  load();
</script>
