---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="글 목록 — xmin.blog" description="xmin.blog 전체 글 목록" active={1} path="posts" maxWidth={1180}>
  <div class="posts-shell">
    <main class="posts-main">
      <div class="v11-list-head" style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;font-family:var(--font-mono);">
        <span class="v11-dim" style="font-size:12.5px;"><span class="v11-gr">$</span> ls -lth --thumbnails posts/</span>
        <span id="posts-count" class="v11-dim" style="font-size:11.5px;">view: <span class="v11-gr">[list]</span> · <a href="/tags">tags</a></span>
      </div>
      <div id="posts-list">
        <div class="v11-dim" style="font-size:12.5px;padding:14px 8px;">posts 불러오는 중…<span class="v11-cursor"></span></div>
      </div>
      <div id="posts-pagination"></div>
    </main>

    <aside class="posts-side" aria-label="posts navigation">
      <section class="posts-widget">
        <h2>// 카테고리</h2>
        <nav id="posts-categories" class="posts-category-list">
          <span class="v11-dim">불러오는 중…</span>
        </nav>
      </section>

      <section class="posts-widget">
        <h2>// 최근 글</h2>
        <div id="posts-recent" class="posts-recent-list">
          <span class="v11-dim">불러오는 중…</span>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<style is:global>
  .posts-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 34px;
    padding-top: 26px;
    padding-bottom: 30px;
  }
  .posts-main { min-width: 0; }
  .posts-side {
    display: grid;
    gap: 18px;
    align-content: start;
    position: sticky;
    top: 64px;
  }
  .posts-widget {
    border: 1px solid var(--color-border);
    background: var(--color-panel);
    border-radius: 4px;
    padding: 18px 18px 16px;
  }
  .posts-widget h2 {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-dim);
  }
  .posts-category-list,
  .posts-recent-list {
    display: grid;
    gap: 10px;
    font-family: var(--font-mono);
  }
  .posts-category-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    color: var(--color-subtle);
    font-size: 12.5px;
  }
  .posts-category-item:hover,
  .posts-category-item.is-active {
    color: var(--color-green-br);
    text-decoration: none;
  }
  .posts-category-count {
    color: var(--color-dim);
  }
  .posts-recent-item {
    display: grid;
    gap: 3px;
    color: var(--color-subtle);
    font-size: 12.5px;
    line-height: 1.35;
  }
  .posts-recent-item:hover {
    color: var(--color-green-br);
    text-decoration: none;
  }
  .posts-recent-date {
    color: var(--color-dim);
    font-size: 11.5px;
  }
  .v11-post-item {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 16px 8px;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }
  .v11-post-item:hover { text-decoration: none; }
  .v11-post-item:hover .pi-title { color: var(--color-green-br); }
  .pi-body { flex: 1 1 auto; min-width: 0; }
  .pi-title {
    font-family: var(--font-sans);
    font-size: 16px; font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 6px;
    line-height: 1.35;
  }
  .pi-desc {
    font-family: var(--font-sans);
    font-size: 13.5px; color: var(--color-subtle);
    line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    margin-bottom: 9px;
  }
  .pi-meta {
    font-family: var(--font-mono);
    font-size: 11.5px; color: var(--color-dim);
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
  }
  .pi-thumb {
    flex: 0 0 auto;
    align-self: center;
    width: 150px; height: 96px;
    overflow: hidden;
    border: 1px solid var(--color-border-d);
    border-radius: 2px;
    background: var(--color-panel);
  }
  .pi-thumb img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.9); transition: filter 0.2s; }
  .v11-post-item:hover .pi-thumb img { filter: brightness(1); }
  @media (max-width: 900px) {
    .posts-shell { grid-template-columns: 1fr; gap: 22px; }
    .posts-side { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); order: -1; }
  }
  @media (max-width: 640px) {
    .posts-side { grid-template-columns: 1fr; }
    .v11-post-item { gap: 16px; }
    .pi-thumb { width: 96px; height: 70px; }
  }
</style>

<script>
  import { areaForPost as areaFor } from '../../lib/area';
  import { bindPagination, paginate, paginationHtml } from '../../lib/pagination';

  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';
  const PAGE_SIZE = 10;
  const params = new URLSearchParams(window.location.search);
  let activeCategory = params.get('category') || '';
  let activePage = Number.parseInt(params.get('page') || '1', 10) || 1;
  let allPosts = [];

  function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function postUrl(slug){return `/post/?slug=${encodeURIComponent(slug)}`;}
  function categoryUrl(category){return category ? `/posts?category=${encodeURIComponent(category)}` : '/posts';}
  function fmtDate(d){try{return new Date(d).toISOString().slice(0,10);}catch{return'';}}
  function shortDate(d){try{return new Date(d).toLocaleDateString('ko-KR',{month:'short',day:'numeric'});}catch{return'';}}
  function normalizeCoverCrop(raw){
    if(!raw) return {x:50,y:50,zoom:1};
    let value=raw;
    if(typeof raw==='string'){try{value=JSON.parse(raw);}catch{value={};}}
    const clamp=(v,min,max,fallback)=>{const n=Number(v);return Number.isFinite(n)?Math.min(max,Math.max(min,n)):fallback;};
    return {x:clamp(value?.x,0,100,50),y:clamp(value?.y,0,100,50),zoom:clamp(value?.zoom,1,3,1)};
  }
  function coverCropStyle(raw){
    const c=normalizeCoverCrop(raw);
    const x=c.x.toFixed(2), y=c.y.toFixed(2), z=c.zoom.toFixed(2);
    return `object-position:${x}% ${y}%;transform:scale(${z});transform-origin:${x}% ${y}%;`;
  }
  function isChannelPost(post){
    const category=String(post.category||'').trim().toLowerCase();
    const source=String(post.source_type||'').trim().toLowerCase();
    const title=String(post.title||'').trim().toLowerCase();
    const tags=(post.tags||[]).map(tag=>String(tag).trim().toLowerCase());
    return ['cve','cve research','security-news','security news'].includes(category)
      || ['cve','security-news'].includes(source)
      || title.startsWith('[cve research]')
      || tags.includes('security-news');
  }

  // representative image: explicit cover, else the post's first body image (derived async)
  function thumbOf(p){ return p.cover || p._thumb || ''; }

  function visiblePosts(){
    if(!activeCategory) return allPosts;
    return allPosts.filter(p => String(p.category || '') === activeCategory);
  }

  function syncPageUrl(page){
    const next = new URLSearchParams(window.location.search);
    if(activeCategory) next.set('category', activeCategory); else next.delete('category');
    if(page > 1) next.set('page', String(page)); else next.delete('page');
    const qs = next.toString();
    history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
  }

  function renderCount(total, pageState){
    const el=document.getElementById('posts-count');
    if(!el) return;
    if(activeCategory){
      el.innerHTML=`${total} / ${allPosts.length} · page ${pageState.page}/${pageState.pageCount} · <span class="v11-gr">${esc(activeCategory)}</span> · <a href="/posts">clear</a>`;
      return;
    }
    el.innerHTML=`${allPosts.length} entries · page ${pageState.page}/${pageState.pageCount} · view: <span class="v11-gr">[list]</span> · <a href="/tags">tags</a>`;
  }

  function render(filteredPosts, pageState){
    const list=document.getElementById('posts-list');
    renderCount(filteredPosts.length, pageState);
    if(!filteredPosts.length){
      list.innerHTML='<div class="v11-dim" style="font-size:12.5px;padding:14px 8px;">조건에 맞는 글이 없습니다.</div>';
      return;
    }
    list.innerHTML=pageState.items.map(p=>{
      const a=areaFor(p);
      const cover=thumbOf(p);
      const tags=(p.tags||[]).slice(0,3).map(t=>`<span class="v11-tag ${a}">#${esc(t)}</span>`).join('');
      const thumb=cover
        ? `<div class="pi-thumb"><img src="${esc(cover)}" alt="${esc(p.coverAlt||p.title)}" loading="lazy" decoding="async" style="${coverCropStyle(p.cover_crop)}"/></div>`
        : '';
      const priv=p.is_private?'<span class="lvl lvl-warn" style="font-size:10px;">priv</span>':'';
      return `<a href="${postUrl(p.slug)}" class="v11-post-item" data-slug="${esc(p.slug)}">
        <div class="pi-body">
          <div class="pi-title">${esc(p.title)}${priv}</div>
          ${p.description?`<div class="pi-desc">${esc(p.description)}</div>`:''}
          <div class="pi-meta"><span class="v11-dim">${esc(fmtDate(p.date))}</span>${tags}</div>
        </div>
        ${thumb}
      </a>`;
    }).join('');
  }

  function categoryEntries(){
    const counts = new Map();
    for(const post of allPosts){
      const category = String(post.category || '').trim();
      if(!category) continue;
      counts.set(category, (counts.get(category) || 0) + 1);
    }
    return [...counts.entries()].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
  }

  function renderCategories(){
    const el=document.getElementById('posts-categories');
    if(!el) return;
    const entries=categoryEntries();
    if(!entries.length){
      el.innerHTML='<span class="v11-dim">카테고리가 없습니다.</span>';
      return;
    }
    const allClass = activeCategory ? '' : ' is-active';
    el.innerHTML=[
      `<a class="posts-category-item${allClass}" href="/posts"><span>all</span><span class="posts-category-count">${allPosts.length}</span></a>`,
      ...entries.map(([category,count])=>{
        const cls=category===activeCategory ? ' is-active' : '';
        return `<a class="posts-category-item${cls}" href="${categoryUrl(category)}"><span>${esc(category)}</span><span class="posts-category-count">${count}</span></a>`;
      })
    ].join('');
  }

  function renderRecent(){
    const el=document.getElementById('posts-recent');
    if(!el) return;
    const recent=allPosts.slice(0,5);
    if(!recent.length){
      el.innerHTML='<span class="v11-dim">아직 글이 없습니다.</span>';
      return;
    }
    el.innerHTML=recent.map(p=>`<a class="posts-recent-item" href="${postUrl(p.slug)}">
      <span>${esc(p.title)}</span>
      <span class="posts-recent-date">${esc(shortDate(p.date))}</span>
    </a>`).join('');
  }

  function renderPage(){
    const posts=visiblePosts();
    const pageState=paginate(posts, activePage, PAGE_SIZE);
    activePage=pageState.page;
    render(posts, pageState);
    renderCategories();
    renderRecent();
    const pager=document.getElementById('posts-pagination');
    if(pager){
      pager.innerHTML=paginationHtml(pageState);
      bindPagination(pager, (page)=>{
        activePage=page;
        syncPageUrl(activePage);
        renderPage();
        document.querySelector('.posts-main')?.scrollIntoView({block:'start'});
      });
    }
    return pageState;
  }

  const IMG_RE=/!\[[^\]]*\]\((https?:\/\/[^)\s"']+)/;
  async function deriveThumbs(posts){
    const need=posts.filter(p=>!p.cover);
    let changed=false;
    await Promise.all(need.map(async (p)=>{
      const key='thumb_'+p.slug;
      let url=sessionStorage.getItem(key);
      if(url===null){
        try{
          const r=await fetch(`${API_BASE}/api/posts/${encodeURIComponent(p.slug)}`);
          if(r.ok){ const d=await r.json(); const m=String(d.content||'').match(IMG_RE); url=m?m[1]:''; }
          else url='';
        }catch{ url=''; }
        try{ sessionStorage.setItem(key, url); }catch{}
      }
      if(url){ p._thumb=url; changed=true; }
    }));
    return changed;
  }

  async function load(){
    try{
      const res=await fetch(`${API_BASE}/api/posts`);
      if(!res.ok) throw new Error('api');
      const data=await res.json();
      allPosts=data.filter(p=>!p.draft&&!p.is_private&&!isChannelPost(p)).sort((a,b)=>new Date(b.date)-new Date(a.date));
      const pageState=renderPage();
      if(await deriveThumbs(pageState.items)) renderPage(); // re-render once derived thumbnails are known
    }catch(e){
      document.getElementById('posts-list').innerHTML='<div class="v11-rd" style="font-size:12.5px;padding:14px 8px;">posts를 불러오지 못했습니다.</div>';
      document.getElementById('posts-categories').innerHTML='<span class="v11-rd">불러오기 실패</span>';
      document.getElementById('posts-recent').innerHTML='<span class="v11-rd">불러오기 실패</span>';
    }
  }
  load();
</script>
