---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout noindex={true} title="마이페이지 — xmin.blog">
  <div class="mx-auto max-w-3xl px-4 sm:px-5 py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight" style="font-family:var(--font-display);">마이페이지</h1>
      <p class="text-sm text-[var(--color-text-secondary)] mt-1" style="font-family:var(--font-mono);">// profile · likes · comments · settings</p>
    </header>

    <div id="mp-loading" class="text-center py-20 text-[var(--color-text-secondary)]">
      <div class="inline-block w-6 h-6 border-2 border-[var(--color-accent)] border-t-transparent rounded-full animate-spin mb-3"></div>
      <p class="text-sm">불러오는 중...</p>
    </div>

    <div id="mp-not-logged-in" class="hidden text-center py-16">
      <p class="text-base mb-4">로그인이 필요합니다.</p>
      <a href="/login" class="inline-block px-4 py-2 rounded-md text-sm font-semibold" style="background:var(--color-accent);color:white;">로그인</a>
    </div>

    <div id="mp-content" class="hidden space-y-8">
      <!-- Profile -->
      <section class="sidebar-widget" style="padding:1.5rem 1.75rem;">
        <p class="sidebar-widget-title">프로필</p>
        <div class="flex items-start gap-4 mb-5">
          <span id="mp-avatar"
            class="w-16 h-16 rounded-full overflow-hidden flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
            style="background:linear-gradient(135deg,#1f8c42,#11512a);">?</span>
          <div class="min-w-0 flex-1">
            <p class="text-base font-bold" id="mp-nickname" style="font-family:var(--font-display);">—</p>
            <p class="text-xs text-[var(--color-text-secondary)] truncate" id="mp-email" style="font-family:var(--font-mono);">—</p>
            <p class="text-xs mt-1" id="mp-role" style="font-family:var(--font-mono);"></p>
          </div>
        </div>

        <form id="mp-profile-form" class="space-y-3">
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">아이디 / 이메일</label>
            <input id="mp-email-input" type="email" readonly
              class="w-full px-3 py-2 rounded-md text-sm outline-none"
              style="background:var(--color-bg);color:var(--color-text-secondary);border:1px solid var(--color-border);font-family:var(--font-mono);" />
          </div>
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">이름 / 표시명</label>
            <input id="mp-nickname-input" type="text" maxlength="40"
              class="w-full px-3 py-2 rounded-md text-sm outline-none transition-colors"
              style="background:var(--color-bg-secondary);color:var(--color-text);border:1px solid var(--color-border);" />
          </div>
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">외부 프로필 이미지 URL</label>
            <input id="mp-avatar-input" type="url" placeholder="https://example.com/avatar.png"
              class="w-full px-3 py-2 rounded-md text-sm outline-none transition-colors"
              style="background:var(--color-bg-secondary);color:var(--color-text);border:1px solid var(--color-border);font-family:var(--font-mono);" />
            <p class="text-[10px] text-[var(--color-text-secondary)] mt-1" style="font-family:var(--font-mono);">// 직접 업로드한 이미지는 내부 URL을 표시하지 않습니다</p>
          </div>
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">프로필 사진 업로드</label>
            <input id="mp-avatar-file" type="file" accept="image/jpeg,image/png,image/webp"
              class="w-full px-3 py-2 rounded-md text-xs outline-none transition-colors"
              style="background:var(--color-bg-secondary);color:var(--color-text-secondary);border:1px dashed var(--color-border);font-family:var(--font-mono);" />
            <p class="text-[10px] text-[var(--color-text-secondary)] mt-1" style="font-family:var(--font-mono);">// JPG · PNG · WebP, 2MB 이하</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit"
              class="px-4 py-2 rounded-md text-sm font-semibold transition-opacity"
              style="background:var(--color-accent);color:white;">저장</button>
            <span id="mp-profile-status" class="text-xs"></span>
            <span id="mp-avatar-upload-status" class="text-xs"></span>
          </div>
        </form>
      </section>

      <!-- Activity summary -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="mp-stat">
          <span class="mp-stat-label">liked</span>
          <strong id="mp-stat-likes">—</strong>
          <span>좋아요한 글</span>
        </div>
        <div class="mp-stat">
          <span class="mp-stat-label">comments</span>
          <strong id="mp-stat-comments">—</strong>
          <span>내가 쓴 댓글</span>
        </div>
        <div class="mp-stat">
          <span class="mp-stat-label">role</span>
          <strong id="mp-stat-role">—</strong>
          <span>계정 권한</span>
        </div>
      </section>

      <!-- Password -->
      <section class="sidebar-widget" style="padding:1.5rem 1.75rem;">
        <p class="sidebar-widget-title">비밀번호 변경</p>
        <div id="mp-pw-admin-notice" class="hidden text-xs text-[var(--color-text-secondary)]" style="font-family:var(--font-mono);">
          // 관리자 비밀번호는 서버 .env에서 관리합니다.
        </div>
        <form id="mp-pw-form" class="space-y-3 hidden">
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">현재 비밀번호</label>
            <input id="mp-pw-old" type="password" required
              class="w-full px-3 py-2 rounded-md text-sm outline-none transition-colors"
              style="background:var(--color-bg-secondary);color:var(--color-text);border:1px solid var(--color-border);font-family:var(--font-mono);" />
          </div>
          <div>
            <label class="block text-xs text-[var(--color-text-secondary)] mb-1" style="font-family:var(--font-mono);">새 비밀번호 (8자 이상)</label>
            <input id="mp-pw-new" type="password" required minlength="8"
              class="w-full px-3 py-2 rounded-md text-sm outline-none transition-colors"
              style="background:var(--color-bg-secondary);color:var(--color-text);border:1px solid var(--color-border);font-family:var(--font-mono);" />
          </div>
          <div class="flex items-center gap-2">
            <button type="submit"
              class="px-4 py-2 rounded-md text-sm font-semibold transition-opacity"
              style="background:var(--color-accent);color:white;">변경</button>
            <span id="mp-pw-status" class="text-xs"></span>
          </div>
        </form>
      </section>

      <!-- Liked posts -->
      <section class="sidebar-widget" style="padding:1.5rem 1.75rem;">
        <div class="flex items-baseline justify-between gap-3 mb-4">
          <p class="sidebar-widget-title" style="margin-bottom:0;">좋아요한 글</p>
          <p id="mp-likes-status" class="mp-meta"></p>
        </div>
        <div id="mp-likes-list" class="space-y-2">
          <p class="text-xs text-[var(--color-text-secondary)]">불러오는 중...</p>
        </div>
        <div id="mp-likes-pagination"></div>
      </section>

      <!-- My Posts (admin only) -->
      <section id="mp-posts-section" class="sidebar-widget hidden" style="padding:1.5rem 1.75rem;">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
          <p class="sidebar-widget-title" style="margin-bottom:0;">내가 쓴 글</p>
          <div class="flex flex-wrap items-center gap-2">
            <input id="mp-post-search" type="search" placeholder="제목/태그 검색" class="mp-filter-input" />
            <select id="mp-post-filter" class="mp-filter-input" aria-label="글 필터">
              <option value="all">전체</option>
              <option value="published">공개 글</option>
              <option value="draft">초안</option>
              <option value="private">비공개</option>
              <option value="cover">대표 이미지 있음</option>
            </select>
          </div>
        </div>
        <p id="mp-posts-count" class="mp-meta mb-2"></p>
        <div id="mp-posts-list" class="space-y-2">
          <p class="text-xs text-[var(--color-text-secondary)]">불러오는 중...</p>
        </div>
        <div id="mp-posts-pagination"></div>
      </section>

      <!-- My Comments -->
      <section class="sidebar-widget" style="padding:1.5rem 1.75rem;">
        <p class="sidebar-widget-title">내가 쓴 댓글</p>
        <div id="mp-comments-list" class="space-y-3">
          <p class="text-xs text-[var(--color-text-secondary)]">불러오는 중...</p>
        </div>
        <div id="mp-comments-pagination"></div>
      </section>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @keyframes spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: spin 0.8s linear infinite; }

  .mp-row {
    padding: 0.75rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    transition: border-color 0.15s;
  }
  .mp-row:hover { border-color: var(--color-accent); }
  .mp-link {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: none;
  }
  .mp-link:hover { text-decoration: underline; }
  .mp-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }
  .mp-del-btn {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    transition: color 0.15s, background 0.15s;
  }
  .mp-del-btn:hover { color: #ef4444; background: rgba(239,68,68,0.08); }
  .mp-priv {
    color: #ca8a04;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    margin-left: 0.35rem;
  }
  .mp-filter-input {
    min-height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    padding: 0.35rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    outline: none;
  }
  .mp-filter-input:focus { border-color: var(--color-accent); }
  .mp-stat {
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    border-radius: 0.5rem;
    padding: 0.9rem 1rem;
    min-height: 5.4rem;
  }
  .mp-stat-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.35rem;
  }
  .mp-stat strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--color-accent);
  }
  .mp-stat span:last-child {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>

<script is:inline>
  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';

  function esc(str) {
    return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  let _user = null;
  let _mpPosts = [];
  let _mpPublicPosts = [];
  let _mpLikes = [];
  let _mpComments = [];
  let _mpPostPage = 1;
  let _mpLikePage = 1;
  let _mpCommentPage = 1;
  const MP_PAGE_SIZE = 6;

  function isUploadedAvatarUrl(value) {
    const raw = String(value || '').trim();
    if (!raw) return false;
    if (raw.startsWith('/uploads/')) return true;
    try {
      const parsed = new URL(raw, window.location.origin);
      const api = new URL(API_BASE);
      return parsed.origin === api.origin && parsed.pathname.startsWith('/uploads/');
    } catch {
      return false;
    }
  }

  function avatarImageSrc(value) {
    const raw = String(value || '').trim();
    if (raw.startsWith('/uploads/')) return `${API_BASE}${raw}`;
    return raw;
  }

  async function mpInit() {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      document.getElementById('mp-loading').classList.add('hidden');
      document.getElementById('mp-not-logged-in').classList.remove('hidden');
      return;
    }
    try {
      const res = await fetch(`${API_BASE}/api/auth/me`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error('Unauthorized');
      _user = await res.json();
      // refresh localStorage user with latest avatar/nickname
      localStorage.setItem('auth_user', JSON.stringify(_user));
    } catch {
      localStorage.removeItem('auth_token');
      localStorage.removeItem('auth_user');
      document.getElementById('mp-loading').classList.add('hidden');
      document.getElementById('mp-not-logged-in').classList.remove('hidden');
      return;
    }
    document.getElementById('mp-loading').classList.add('hidden');
    document.getElementById('mp-content').classList.remove('hidden');
    renderProfile();
    renderPasswordSection();
    if (_user.role === 'admin') {
      document.getElementById('mp-posts-section').classList.remove('hidden');
      loadMyPosts();
    }
    loadMyLikes();
    loadMyComments();
  }

  function renderProfile() {
    const display = _user.nickname || (_user.email ? _user.email.split('@')[0] : '?');
    document.getElementById('mp-nickname').textContent = display;
    document.getElementById('mp-email').textContent = _user.email;
    const roleEl = document.getElementById('mp-role');
    if (_user.role === 'admin') {
      roleEl.innerHTML = '<span style="color:var(--color-accent);">[admin]</span>';
    } else {
      roleEl.innerHTML = '<span style="color:var(--color-text-secondary);">[user]</span>';
    }
    document.getElementById('mp-stat-role').textContent = _user.role || 'user';
    const avatarEl = document.getElementById('mp-avatar');
    avatarEl.textContent = '';
    const fallback = (display[0] || '?').toUpperCase();
    if (_user.avatar_url) {
      const img = document.createElement('img');
      img.src = avatarImageSrc(_user.avatar_url);
      img.alt = '';
      img.className = 'w-full h-full object-cover';
      img.style.cssText = 'display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;';
      img.addEventListener('error', () => {
        avatarEl.textContent = fallback;
      }, { once: true });
      avatarEl.appendChild(img);
    } else {
      avatarEl.textContent = fallback;
    }
    document.getElementById('mp-nickname-input').value = display;
    document.getElementById('mp-email-input').value = _user.email || '';
    document.getElementById('mp-avatar-input').value = isUploadedAvatarUrl(_user.avatar_url) ? '' : (_user.avatar_url || '');
  }

  function setMpStat(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = String(value);
  }

  function mpPaginate(items, page, pageSize = MP_PAGE_SIZE) {
    const total = items.length;
    const pageCount = Math.max(1, Math.ceil(total / pageSize));
    const current = Math.min(pageCount, Math.max(1, Number.parseInt(String(page || 1), 10) || 1));
    const startIndex = (current - 1) * pageSize;
    return {
      items: items.slice(startIndex, startIndex + pageSize),
      page: current,
      pageCount,
      total,
      start: total ? startIndex + 1 : 0,
      end: Math.min(total, startIndex + pageSize),
    };
  }

  function mpRenderPager(id, state, onPage) {
    const el = document.getElementById(id);
    if (!el) return;
    if (state.pageCount <= 1) {
      el.innerHTML = '';
      return;
    }
    el.innerHTML = `<nav class="v11-pagination" aria-label="pagination">
      <button type="button" class="v11-pagination-btn" data-mp-page="${state.page - 1}" ${state.page <= 1 ? 'disabled' : ''}>prev</button>
      <span class="v11-pagination-range">${state.start}-${state.end} / ${state.total}</span>
      <button type="button" class="v11-pagination-btn" data-mp-page="${state.page + 1}" ${state.page >= state.pageCount ? 'disabled' : ''}>next</button>
    </nav>`;
    el.querySelectorAll('[data-mp-page]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        onPage(Number.parseInt(button.dataset.mpPage || '1', 10) || 1);
      });
    });
  }

  document.getElementById('mp-profile-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('mp-profile-status');
    const nickname = document.getElementById('mp-nickname-input').value.trim();
    const externalAvatarUrl = document.getElementById('mp-avatar-input').value.trim();
    const payload = { nickname };
    if (externalAvatarUrl || !isUploadedAvatarUrl(_user.avatar_url)) {
      payload.avatar_url = externalAvatarUrl;
    }
    status.textContent = '저장 중...';
    status.style.color = 'var(--color-text-secondary)';
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/auth/profile`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      _user = { ..._user, ...data };
      localStorage.setItem('auth_user', JSON.stringify(_user));
      renderProfile();
      status.textContent = '저장됨';
      status.style.color = '#3fb950';
      setTimeout(() => { status.textContent = ''; }, 2500);
    } catch (err) {
      status.textContent = '오류: ' + err.message;
      status.style.color = '#ef4444';
    }
  });

  document.getElementById('mp-avatar-file')?.addEventListener('change', async (event) => {
    const input = event.target;
    const file = input?.files?.[0];
    if (!file) return;
    try {
      await uploadAvatarFile(file);
    } finally {
      input.value = '';
    }
  });

  async function uploadAvatarFile(file) {
    const status = document.getElementById('mp-avatar-upload-status');
    const allowed = new Set(['image/jpeg', 'image/png', 'image/webp']);
    if (!allowed.has(file.type)) {
      status.textContent = 'JPG/PNG/WebP만 가능';
      status.style.color = '#ef4444';
      return;
    }
    if (file.size > 2 * 1024 * 1024) {
      status.textContent = '2MB 이하만 가능';
      status.style.color = '#ef4444';
      return;
    }

    const token = localStorage.getItem('auth_token');
    if (!token) {
      status.textContent = '로그인이 필요합니다';
      status.style.color = '#ef4444';
      return;
    }

    const fd = new FormData();
    fd.append('file', file);
    status.textContent = '업로드 중...';
    status.style.color = 'var(--color-text-secondary)';
    try {
      const res = await fetch(`${API_BASE}/api/auth/avatar`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 404 || data.error === 'Not found') {
          throw new Error('프로필 업로드 API가 아직 배포되지 않았습니다. api.xmin.cloud 재배포가 필요합니다.');
        }
        if (res.status === 401) {
          throw new Error('로그인이 만료되었습니다. 다시 로그인해 주세요.');
        }
        throw new Error(data.error || `HTTP ${res.status}`);
      }
      _user = { ..._user, ...data };
      localStorage.setItem('auth_user', JSON.stringify(_user));
      renderProfile();
      status.textContent = '업로드됨 · URL 숨김';
      status.style.color = '#3fb950';
      setTimeout(() => { status.textContent = ''; }, 2500);
    } catch (err) {
      status.textContent = '업로드 실패: ' + err.message;
      status.style.color = '#ef4444';
    }
  }

  function renderPasswordSection() {
    const notice = document.getElementById('mp-pw-admin-notice');
    const form = document.getElementById('mp-pw-form');
    if (_user.role === 'admin') {
      notice.classList.remove('hidden');
      form.classList.add('hidden');
    } else {
      notice.classList.add('hidden');
      form.classList.remove('hidden');
    }
  }

  document.getElementById('mp-pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('mp-pw-status');
    const oldPw = document.getElementById('mp-pw-old').value;
    const newPw = document.getElementById('mp-pw-new').value;
    if (newPw.length < 8) { status.textContent = '새 비밀번호는 8자 이상'; status.style.color = '#ef4444'; return; }
    status.textContent = '변경 중...';
    status.style.color = 'var(--color-text-secondary)';
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/auth/change-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ old_password: oldPw, new_password: newPw }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      status.textContent = '변경됨';
      status.style.color = '#3fb950';
      document.getElementById('mp-pw-old').value = '';
      document.getElementById('mp-pw-new').value = '';
      setTimeout(() => { status.textContent = ''; }, 2500);
    } catch (err) {
      status.textContent = '오류: ' + err.message;
      status.style.color = '#ef4444';
    }
  });

  function normalizeMpSearch(value) {
    return String(value || '').toLowerCase().normalize('NFKC');
  }

  function renderMyPosts() {
    const list = document.getElementById('mp-posts-list');
    const count = document.getElementById('mp-posts-count');
    const mode = document.getElementById('mp-post-filter')?.value || 'all';
    const query = normalizeMpSearch(document.getElementById('mp-post-search')?.value || '').split(/\s+/).filter(Boolean);
    let posts = _mpPosts.slice();
    if (mode === 'published') posts = posts.filter(p => !p.draft && !p.is_private);
    if (mode === 'draft') posts = posts.filter(p => p.draft);
    if (mode === 'private') posts = posts.filter(p => p.is_private);
    if (mode === 'cover') posts = posts.filter(p => !!p.cover);
    if (query.length) {
      posts = posts.filter(p => {
        const haystack = normalizeMpSearch([p.title, p.description, p.category, p.slug, ...(p.tags || [])].join(' '));
        return query.every(term => haystack.includes(term));
      });
    }
    const pageState = mpPaginate(posts, _mpPostPage);
    _mpPostPage = pageState.page;
    count.textContent = `${posts.length.toLocaleString('ko-KR')}개 표시 / 전체 ${_mpPosts.length.toLocaleString('ko-KR')}개 · page ${pageState.page}/${pageState.pageCount}`;
    if (!posts.length) {
      list.innerHTML = '<p class="text-xs text-[var(--color-text-secondary)]">조건에 맞는 글이 없습니다.</p>';
      mpRenderPager('mp-posts-pagination', pageState, () => {});
      return;
    }
    list.innerHTML = pageState.items.map(p => {
      const date = p.date ? new Date(p.date).toLocaleDateString('ko-KR') : '';
      const draft = p.draft ? '<span class="mp-priv">[draft]</span>' : '';
      const priv = p.is_private ? '<span class="mp-priv">[private]</span>' : '';
      const cover = p.cover ? '<span class="mp-priv" style="color:var(--color-accent);">[cover]</span>' : '';
      return `<div class="mp-row flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <a href="/post/?slug=${encodeURIComponent(p.slug)}" class="mp-link text-sm">${esc(p.title)}</a>${draft}${priv}${cover}
          <p class="mp-meta mt-0.5">${esc(date)} · [${esc(p.category)}] · ${esc(p.slug)}</p>
        </div>
        <div class="flex gap-1 flex-shrink-0">
          <a href="/post/?slug=${encodeURIComponent(p.slug)}" class="mp-del-btn" style="color:var(--color-accent);">편집</a>
          <button class="mp-del-btn" onclick="mpDeletePost('${esc(p.slug)}')">삭제</button>
        </div>
      </div>`;
    }).join('');
    mpRenderPager('mp-posts-pagination', pageState, (page) => {
      _mpPostPage = page;
      renderMyPosts();
    });
  }

  async function loadMyPosts() {
    const list = document.getElementById('mp-posts-list');
    try {
      const res = await fetch(`${API_BASE}/api/posts`, { headers: { Authorization: `Bearer ${localStorage.getItem('auth_token') || ''}` } });
      if (!res.ok) throw new Error('failed');
      _mpPosts = await res.json();
      renderMyPosts();
    } catch (err) {
      list.innerHTML = `<p class="text-xs" style="color:#ef4444;">불러오기 실패: ${esc(err.message)}</p>`;
    }
  }

  async function ensurePostSummaries() {
    if (_mpPublicPosts.length) return _mpPublicPosts;
    const headers = {};
    const token = localStorage.getItem('auth_token');
    if (token) headers.Authorization = `Bearer ${token}`;
    const res = await fetch(`${API_BASE}/api/posts`, { headers });
    if (!res.ok) throw new Error('posts failed');
    _mpPublicPosts = await res.json();
    return _mpPublicPosts;
  }

  function fmtDateTime(value) {
    if (!value) return '';
    const date = typeof value === 'number' ? new Date(value * 1000) : new Date(value);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleString('ko-KR');
  }

  function renderMyLikes(rows) {
    const list = document.getElementById('mp-likes-list');
    const status = document.getElementById('mp-likes-status');
    _mpLikes = rows || [];
    setMpStat('mp-stat-likes', _mpLikes.length.toLocaleString('ko-KR'));
    const pageState = mpPaginate(_mpLikes, _mpLikePage);
    _mpLikePage = pageState.page;
    if (status) status.textContent = `${_mpLikes.length.toLocaleString('ko-KR')}개${_mpLikes.length ? ` · page ${pageState.page}/${pageState.pageCount}` : ''}`;
    if (!_mpLikes.length) {
      list.innerHTML = '<p class="text-xs text-[var(--color-text-secondary)]">아직 좋아요한 글이 없습니다.</p>';
      mpRenderPager('mp-likes-pagination', pageState, () => {});
      return;
    }
    const bySlug = new Map(_mpPublicPosts.map(p => [p.slug, p]));
    list.innerHTML = pageState.items.map(item => {
      const slug = item.post_slug || item.slug;
      const post = bySlug.get(slug);
      const title = item.post_title || post?.title || slug;
      const desc = item.post_description || post?.description || '';
      const likedAt = fmtDateTime(item.created_at);
      const postDate = item.post_date || post?.date;
      const date = postDate ? new Date(postDate).toLocaleDateString('ko-KR') : '';
      return `<a href="/post/?slug=${encodeURIComponent(slug)}" class="mp-row block">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="mp-link text-sm">${esc(title)}</p>
            ${desc ? `<p class="text-xs mt-1 leading-relaxed text-[var(--color-text-secondary)]">${esc(desc)}</p>` : ''}
            <p class="mp-meta mt-1.5">${date ? `${esc(date)} · ` : ''}liked ${esc(likedAt)}</p>
          </div>
          <span class="text-xs flex-shrink-0" style="color:#f43f5e;">♥</span>
        </div>
      </a>`;
    }).join('');
    mpRenderPager('mp-likes-pagination', pageState, (page) => {
      _mpLikePage = page;
      renderMyLikes(_mpLikes);
    });
  }

  async function loadMyLikes() {
    const list = document.getElementById('mp-likes-list');
    const status = document.getElementById('mp-likes-status');
    const token = localStorage.getItem('auth_token');
    if (status) status.textContent = 'syncing';
    try {
      const [posts, likesRes] = await Promise.all([
        ensurePostSummaries(),
        fetch(`${API_BASE}/api/auth/my-likes`, { headers: { Authorization: `Bearer ${token}` } }),
      ]);
      _mpPublicPosts = posts;
      if (likesRes.ok) {
        renderMyLikes(await likesRes.json());
        return;
      }
      if (likesRes.status !== 404) throw new Error('likes failed');
      await loadMyLikesFallback();
    } catch (err) {
      try {
        await loadMyLikesFallback();
      } catch {
        setMpStat('mp-stat-likes', '—');
        if (status) status.textContent = '';
        list.innerHTML = `<p class="text-xs" style="color:#ef4444;">불러오기 실패: ${esc(err.message)}</p>`;
      }
    }
  }

  async function loadMyLikesFallback() {
    const token = localStorage.getItem('auth_token');
    const posts = await ensurePostSummaries();
    const liked = [];
    for (let i = 0; i < posts.length; i += 8) {
      const batch = posts.slice(i, i + 8);
      const results = await Promise.all(batch.map(async (post) => {
        try {
          const res = await fetch(`${API_BASE}/api/likes/${encodeURIComponent(post.slug)}`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (!res.ok) return null;
          const data = await res.json();
          return data.liked ? { post_slug: post.slug, created_at: post.date, count: data.count } : null;
        } catch {
          return null;
        }
      }));
      liked.push(...results.filter(Boolean));
    }
    renderMyLikes(liked);
  }

  document.getElementById('mp-post-search')?.addEventListener('input', () => { _mpPostPage = 1; renderMyPosts(); });
  document.getElementById('mp-post-filter')?.addEventListener('change', () => { _mpPostPage = 1; renderMyPosts(); });

  async function mpDeletePost(slug) {
    if (!confirm(`"${slug}" 글을 삭제할까요?`)) return;
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/posts/${encodeURIComponent(slug)}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({}),
      });
      if (res.ok) {
        _mpPosts = _mpPosts.filter(p => p.slug !== slug);
        _mpPublicPosts = _mpPublicPosts.filter(p => p.slug !== slug);
        renderMyPosts();
        await Promise.all([loadMyLikes(), loadMyComments()]);
      }
      else { const d = await res.json(); alert('삭제 실패: ' + (d.error || res.status)); }
    } catch (e) { alert('오류: ' + e.message); }
  }

  function renderMyComments(comments) {
    const list = document.getElementById('mp-comments-list');
    _mpComments = comments || [];
    setMpStat('mp-stat-comments', _mpComments.length.toLocaleString('ko-KR'));
    const pageState = mpPaginate(_mpComments, _mpCommentPage);
    _mpCommentPage = pageState.page;
    if (!_mpComments.length) {
      list.innerHTML = '<p class="text-xs text-[var(--color-text-secondary)]">댓글이 없습니다.</p>';
      mpRenderPager('mp-comments-pagination', pageState, () => {});
      return;
    }
    list.innerHTML = pageState.items.map(c => {
      const date = new Date(Number(c.created_at) * 1000).toLocaleString('ko-KR');
      const title = c.post_title || c.post_slug;
      return `<div class="mp-row" id="mp-c-${c.id}">
        <div class="flex items-start justify-between gap-2 mb-1">
          <a href="/post/?slug=${encodeURIComponent(c.post_slug)}" class="mp-link text-xs">${esc(title)}</a>
          <button class="mp-del-btn" onclick="mpDeleteComment(${c.id})">삭제</button>
        </div>
        <p class="text-sm leading-relaxed" style="color:var(--color-text);">${esc(c.content)}</p>
        <p class="mp-meta mt-1.5">${esc(date)}</p>
      </div>`;
    }).join('');
    mpRenderPager('mp-comments-pagination', pageState, (page) => {
      _mpCommentPage = page;
      renderMyComments(_mpComments);
    });
  }

  async function loadMyComments() {
    const list = document.getElementById('mp-comments-list');
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/auth/my-comments`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error('failed');
      renderMyComments(await res.json());
    } catch (err) {
      setMpStat('mp-stat-comments', '—');
      list.innerHTML = `<p class="text-xs" style="color:#ef4444;">불러오기 실패: ${esc(err.message)}</p>`;
    }
  }

  async function mpDeleteComment(id) {
    if (!confirm('댓글을 삭제할까요?')) return;
    const token = localStorage.getItem('auth_token');
    try {
      const res = await fetch(`${API_BASE}/api/comments/id/${id}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) renderMyComments(_mpComments.filter(c => c.id !== id));
      else alert('삭제 실패');
    } catch (e) { alert('오류: ' + e.message); }
  }

  mpInit();
</script>
