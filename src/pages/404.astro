---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — xmin.blog" description="요청한 페이지를 찾을 수 없습니다." noindex={true}>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-sm text-[var(--color-text-secondary)] mb-3" style="font-family:var(--font-mono);">404</p>
    <h1 class="text-3xl font-bold mb-4" style="font-family:var(--font-display);">페이지를 찾을 수 없습니다</h1>
    <p class="text-[var(--color-text-secondary)] mb-8">주소가 바뀌었거나 삭제된 페이지입니다.</p>
    <a href="/" class="inline-flex px-4 py-2 rounded-lg text-sm font-semibold" style="background:var(--color-accent);color:white;">홈으로 돌아가기</a>
  </section>
</BaseLayout>

<script is:inline>
  // DB-backed posts are rendered by /post/slug/. If an old/static-style
  // /blog/slug/ link points to a post that is not part of the static build,
  // recover the reader instead of leaving them on a dead 404 page.
  const match = window.location.pathname.match(/^\/(?:blog|posts)\/(.+?)\/?$/);
  if (match?.[1]) {
    window.location.replace(`/post/${match[1]}/`);
  }
</script>
