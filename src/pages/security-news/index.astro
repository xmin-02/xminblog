---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Security News — xmin.blog"
  description="매일 보안 동향을 정리하는 xmin.blog 채널"
  active={4}
  path="security-news"
  maxWidth={960}
>
  <section class="v11-channel">
    <div class="v11-dim v11-channel-cmd"><span class="v11-gr">$</span> journalctl -u security-news.timer</div>
    <h1 class="v11-sans v11-channel-title"><span class="v11-gr">Security</span> News</h1>
    <p class="v11-sans v11-channel-copy">
      주요 보안 뉴스와 위협 동향, 패치 이슈를 하루 단위로 정리하는 공간입니다. 원문 링크와 판단 근거를 남기는
      짧은 브리핑 형태가 이 블로그 톤에 가장 잘 맞습니다.
    </p>

    <div class="v11-channel-panel">
      <div class="v11-channel-panel-head">
        <span><span class="v11-gr">$</span> ls posts/ --category "Security News"</span>
        <span class="v11-dim" id="security-news-count">syncing…</span>
      </div>
      <div id="security-news-posts">
        <div class="v11-dim v11-channel-empty">보안 뉴스 글을 불러오는 중…<span class="v11-cursor"></span></div>
      </div>
    </div>

    <div class="v11-channel-notes">
      <span class="lvl lvl-ok">src</span> CISA · vendor blogs · threat intel feeds · trusted media
      <span class="v11-dim">/ cadence: daily digest · manual publish</span>
    </div>
  </section>
</Layout>

<script>
  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';
  const wantedTags = ['security-news', 'security news', 'news', '동향', '보안뉴스'];

  function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function postUrl(slug){return `/post/?slug=${encodeURIComponent(slug)}`;}
  function fmtDate(d){try{return new Date(d).toISOString().slice(0,10);}catch{return'';}}
  function isSecurityNewsPost(post){
    const category = String(post.category || '').toLowerCase();
    const source = String(post.source_type || '').toLowerCase();
    const tags = (post.tags || []).map((tag) => String(tag).toLowerCase());
    return category === 'security news'
      || category === 'security-news'
      || source === 'security-news'
      || wantedTags.some((tag) => tags.includes(tag));
  }
  function render(posts){
    const list = document.getElementById('security-news-posts');
    const count = document.getElementById('security-news-count');
    count.textContent = `${posts.length} entries`;
    if (!posts.length) {
      list.innerHTML = '<div class="v11-dim v11-channel-empty">아직 Security News 채널 글이 없습니다. 데일리 브리핑 자동화가 붙으면 여기에 모입니다.</div>';
      return;
    }
    list.innerHTML = posts.map((post) => `<a class="v11-channel-row" href="${postUrl(post.slug)}">
      <span class="v11-dim">${esc(fmtDate(post.date))}</span>
      <span>
        <span class="v11-channel-row-title">${esc(post.title)}</span>
        ${post.description ? `<span class="v11-channel-row-desc">${esc(post.description)}</span>` : ''}
      </span>
      <span class="v11-dim">${(post.tags || []).slice(0, 2).map((tag) => `#${esc(tag)}`).join(' ')}</span>
    </a>`).join('');
  }
  async function load(){
    try {
      const response = await fetch(`${API_BASE}/api/posts`);
      if (!response.ok) throw new Error('load failed');
      const posts = await response.json();
      render(posts.filter(isSecurityNewsPost));
    } catch {
      document.getElementById('security-news-count').textContent = 'offline';
      document.getElementById('security-news-posts').innerHTML = '<div class="v11-dim v11-channel-empty">포스트 API를 불러오지 못했습니다.</div>';
    }
  }
  load();
</script>
