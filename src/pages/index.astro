---
import Layout from '../layouts/Layout.astro';
import BootLog from '../components/BootLog.astro';
import Neofetch from '../components/Neofetch.astro';
import Heatmap from '../components/Heatmap.astro';
---

<Layout title="xmin.blog" active={0} path="">
  <div style="padding-top:30px;padding-bottom:26px;">
    <BootLog />

    <!-- hero + neofetch -->
    <div class="v11-home-grid">
      <div>
        <div class="v11-dim" style="font-size:12px;margin-bottom:14px;">// xmin.blog — security research notes</div>
        <h1 class="v11-sans v11-hero-h1">
          취약점을 추적하고,<br />
          <span class="v11-gr">AI</span>로 더 안전한<br />
          시스템을 설계합니다.
        </h1>
        <p class="v11-sans" style="font-size:14.5px;color:var(--color-subtle);max-width:540px;margin-top:16px;line-height:1.75;">
          주수민 · AI Security Engineer. 공격자 관점에서 시스템을 살피고, 퍼징과 바이너리 분석으로 취약점을 추적합니다.
          이곳에는 보안 리서치 회고와 실험 기록을 남깁니다.<span class="v11-cursor"></span>
        </p>
        <div style="margin-top:18px;font-size:12.5px;color:var(--color-subtle);line-height:2;">
          <div><span class="v11-gr">$</span> open <a href="/posts" id="cmd-latest">posts/latest</a> <span class="v11-dim">// 최근 글</span></div>
          <div><span class="v11-gr">$</span> cat <a href="/posts">posts/security</a> <span class="v11-dim">// 보안 리서치</span></div>
          <div><span class="v11-gr">$</span> ssh <a href="https://xmin.sh" target="_blank" rel="noopener">xmin.sh</a> <span class="v11-dim">// 포트폴리오</span></div>
        </div>
      </div>
      <Neofetch />
    </div>

    <!-- posts -->
    <div style="margin-top:24px;">
      <div class="v11-list-head">
        <span class="v11-dim" style="font-size:12.5px;"><span class="v11-gr">$</span> ls -lth posts/ <span class="v11-dim">| head -7</span></span>
        <span class="v11-dim" style="font-size:11.5px;"><span class="kbd">j</span><span class="kbd">k</span> nav · <span class="kbd">⏎</span> open · <span class="kbd">/</span> search</span>
      </div>
      <div id="post-list">
        <div class="v11-dim" style="font-size:12.5px;padding:14px 12px;">posts 불러오는 중…<span class="v11-cursor"></span></div>
      </div>
      <div class="v11-dim" id="post-foot" style="font-size:12px;margin-top:10px;text-align:right;"></div>
    </div>

    <!-- heatmap -->
    <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--color-border);">
      <Heatmap />
    </div>

    <!-- footer -->
    <footer style="margin-top:28px;padding-top:14px;border-top:1px solid var(--color-border);display:flex;justify-content:space-between;font-size:12px;color:var(--color-dim);flex-wrap:wrap;gap:8px;">
      <span>© 2026 xmin · <span class="v11-gr">no-ads</span> · <span class="v11-gr">no-trackers</span> · <span class="v11-gr">human-written</span></span>
      <span><a href="https://xmin.sh" target="_blank" rel="noopener">xmin.sh</a> · <a href="https://github.com/xmin-02" target="_blank" rel="noopener">github</a> · <a href="/rss.xml">rss</a></span>
    </footer>
  </div>
</Layout>

<style is:global>
  .v11-home-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 40px;
    margin-top: 24px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--color-border);
  }
  .v11-hero-h1 {
    font-size: 34px;
    line-height: 1.25;
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-fg);
  }
  .v11-list-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 12px; font-family: var(--font-mono);
  }
  .v11-post-row {
    display: grid;
    grid-template-columns: 14px 102px 1fr 180px 50px;
    gap: 14px;
    align-items: baseline;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border);
    border-left: 2px solid transparent;
    color: inherit;
  }
  .v11-post-row:hover { text-decoration: none; }
  .v11-post-row:hover .v11-post-title { color: var(--color-green-br); }
  .v11-post-row.is-first { background: var(--color-panel); border-left-color: var(--color-green); }
  .v11-post-title { color: var(--color-fg); font-family: var(--font-sans); font-size: 14.5px; }
  @media (max-width: 720px) {
    .v11-home-grid { grid-template-columns: 1fr; gap: 24px; }
    .v11-post-row { grid-template-columns: 12px 84px 1fr; }
    .v11-post-row .v11-post-tags, .v11-post-row .v11-post-read { display: none; }
  }
</style>

<script>
  import { areaForPost as areaFor } from '../lib/area';

  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';

  function esc(s) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function postUrl(slug) { return `/post/?slug=${encodeURIComponent(slug)}`; }
  function isChannelPost(post) {
    const category = String(post.category || '').trim().toLowerCase();
    const source = String(post.source_type || '').trim().toLowerCase();
    const title = String(post.title || '').trim().toLowerCase();
    const tags = (post.tags || []).map((tag) => String(tag).trim().toLowerCase());
    return ['cve', 'cve research', 'security-news', 'security news'].includes(category)
      || ['cve', 'security-news'].includes(source)
      || title.startsWith('[cve research]')
      || tags.includes('security-news');
  }

  function readTime(post) {
    const n = ((post.title || '').length + (post.description || '').length) * 6 + 600;
    return Math.max(3, Math.round(n / 350)) + 'm';
  }
  function fmtDate(d) {
    if (!d) return '';
    try { return new Date(d).toISOString().slice(0, 10); } catch { return ''; }
  }

  function renderRows(posts) {
    const list = document.getElementById('post-list');
    const foot = document.getElementById('post-foot');
    if (!posts.length) {
      list.innerHTML = '<div class="v11-dim" style="font-size:12.5px;padding:14px 12px;">해당하는 글이 없습니다.</div>';
      if (foot) foot.textContent = '';
      return;
    }
    const top = posts.slice(0, 7);
    list.innerHTML = top.map((p, i) => {
      const area = areaFor(p);
      const tags = (p.tags || []).slice(0, 2).map((t) => `<span class="v11-tag ${area}" style="margin-right:8px;">#${esc(t)}</span>`).join('');
      const lock = p.is_private ? '<span class="lvl lvl-warn" style="font-size:9.5px;margin-left:6px;">priv</span>' : '';
      return `<a href="${postUrl(p.slug)}" class="v11-post-row${i === 0 ? ' is-first' : ''}">
        <span style="font-size:12px;color:${i === 0 ? 'var(--color-green)' : 'var(--color-dim)'};">${i === 0 ? '▸' : '·'}</span>
        <span class="v11-dim" style="font-size:12px;">${esc(fmtDate(p.date))}</span>
        <span class="v11-post-title" style="font-weight:${i === 0 ? 600 : 400};">${esc(p.title)}${lock}</span>
        <span class="v11-post-tags" style="font-size:11px;">${tags}</span>
        <span class="v11-post-read v11-dim" style="font-size:11.5px;text-align:right;">${readTime(p)}</span>
      </a>`;
    }).join('');
    if (foot) foot.innerHTML = `${top.length} / ${posts.length} · <a href="/posts">cat archive</a>`;
  }

  function updateCounts(n) {
    document.querySelectorAll('[data-posts-count]').forEach((el) => { el.textContent = n; });
    document.querySelectorAll('[data-mount-posts]').forEach((el) => {
      el.textContent = el.textContent.replace(/\(\d+ entries/, `(${n} entries`);
    });
  }

  async function load() {
    try {
      const res = await fetch(`${API_BASE}/api/posts`);
      if (!res.ok) throw new Error('api');
      const data = await res.json();
      const posts = data.filter((p) => !p.draft && !p.is_private && !isChannelPost(p))
        .sort((a, b) => new Date(b.date) - new Date(a.date));
      renderRows(posts);
      updateCounts(posts.length);
      const latest = posts[0];
      if (latest) document.getElementById('cmd-latest')?.setAttribute('href', postUrl(latest.slug));
    } catch (e) {
      document.getElementById('post-list').innerHTML =
        '<div class="v11-rd" style="font-size:12.5px;padding:14px 12px;">posts를 불러오지 못했습니다.</div>';
    }
  }
  load();
</script>
