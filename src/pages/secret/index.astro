---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="비밀 글 — xmin.blog"
  description="관리자 전용 비공개 글 목록"
  active={2}
  path="secret"
  maxWidth={1180}
  noindex
>
  <div class="secret-shell">
    <main class="secret-main">
      <div class="v11-list-head" style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;font-family:var(--font-mono);">
        <span class="v11-dim" style="font-size:12.5px;"><span class="v11-gr">$</span> ls -lth --private secret/</span>
        <span id="secret-count" class="v11-dim" style="font-size:11.5px;">view: <span class="v11-gr">[private]</span></span>
      </div>
      <div id="secret-list">
        <div class="v11-dim" style="font-size:12.5px;padding:14px 8px;">비밀 글을 확인하는 중…<span class="v11-cursor"></span></div>
      </div>
      <div id="secret-pagination"></div>
    </main>

    <aside class="secret-side" aria-label="secret posts navigation">
      <section class="secret-widget">
        <h2>// 카테고리</h2>
        <nav id="secret-categories" class="secret-category-list">
          <span class="v11-dim">불러오는 중…</span>
        </nav>
      </section>

      <section class="secret-widget">
        <h2>// 최근 비밀 글</h2>
        <div id="secret-recent" class="secret-recent-list">
          <span class="v11-dim">불러오는 중…</span>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<style is:global>
  .secret-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 34px;
    padding-top: 26px;
    padding-bottom: 30px;
  }
  .secret-main { min-width: 0; }
  .secret-side {
    display: grid;
    gap: 18px;
    align-content: start;
    position: sticky;
    top: 64px;
  }
  .secret-widget {
    border: 1px solid var(--color-border);
    background: var(--color-panel);
    border-radius: 4px;
    padding: 18px 18px 16px;
  }
  .secret-widget h2 {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-dim);
  }
  .secret-category-list,
  .secret-recent-list {
    display: grid;
    gap: 10px;
    font-family: var(--font-mono);
  }
  .secret-category-item {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    color: var(--color-subtle);
    font-size: 12.5px;
  }
  .secret-category-item:hover,
  .secret-category-item.is-active {
    color: var(--color-green-br);
    text-decoration: none;
  }
  .secret-category-count {
    color: var(--color-dim);
  }
  .secret-recent-item {
    display: grid;
    gap: 3px;
    color: var(--color-subtle);
    font-size: 12.5px;
    line-height: 1.35;
  }
  .secret-recent-item:hover {
    color: var(--color-green-br);
    text-decoration: none;
  }
  .secret-recent-date {
    color: var(--color-dim);
    font-size: 11.5px;
  }
  .secret-post-item {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 16px 8px;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }
  .secret-post-item:hover { text-decoration: none; }
  .secret-post-item:hover .pi-title { color: var(--color-green-br); }
  .secret-empty {
    border: 1px solid var(--color-border);
    background: var(--color-panel);
    border-radius: 4px;
    padding: 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-subtle);
  }
  @media (max-width: 900px) {
    .secret-shell { grid-template-columns: 1fr; gap: 22px; }
    .secret-side { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); order: -1; }
  }
  @media (max-width: 640px) {
    .secret-side { grid-template-columns: 1fr; }
    .secret-post-item { gap: 16px; }
  }
</style>

<script>
  import { areaForPost as areaFor } from '../../lib/area';
  import { bindPagination, paginate, paginationHtml } from '../../lib/pagination';

  const API_BASE = window.__XMIN_API_BASE__ || 'https://api.xmin.cloud';
  const PAGE_SIZE = 10;
  const params = new URLSearchParams(window.location.search);
  let activeCategory = params.get('category') || '';
  let activePage = Number.parseInt(params.get('page') || '1', 10) || 1;
  let allPosts = [];
  let authToken = '';

  function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function postUrl(slug){return `/post/?slug=${encodeURIComponent(slug)}`;}
  function secretUrl(category){return category ? `/secret?category=${encodeURIComponent(category)}` : '/secret';}
  function fmtDate(d){try{return new Date(d).toISOString().slice(0,10);}catch{return'';}}
  function shortDate(d){try{return new Date(d).toLocaleDateString('ko-KR',{month:'short',day:'numeric'});}catch{return'';}}
  function normalizeCoverCrop(raw){
    if(!raw) return {x:50,y:50,zoom:1};
    let value=raw;
    if(typeof raw==='string'){try{value=JSON.parse(raw);}catch{value={};}}
    const clamp=(v,min,max,fallback)=>{const n=Number(v);return Number.isFinite(n)?Math.min(max,Math.max(min,n)):fallback;};
    return {x:clamp(value?.x,0,100,50),y:clamp(value?.y,0,100,50),zoom:clamp(value?.zoom,1,3,1)};
  }
  function coverCropStyle(raw){
    const c=normalizeCoverCrop(raw);
    const x=c.x.toFixed(2), y=c.y.toFixed(2), z=c.zoom.toFixed(2);
    return `object-position:${x}% ${y}%;transform:scale(${z});transform-origin:${x}% ${y}%;`;
  }
  function thumbOf(p){ return p.cover || p._thumb || ''; }

  async function ensureAdmin(){
    const token = localStorage.getItem('auth_token') || '';
    const raw = localStorage.getItem('auth_user');
    let user = null;
    try { user = raw ? JSON.parse(raw) : null; } catch {}
    if (!token || user?.role !== 'admin') return '';
    try {
      const res = await fetch(`${API_BASE}/api/auth/me`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error('auth');
      user = await res.json();
      localStorage.setItem('auth_user', JSON.stringify(user));
      return user?.role === 'admin' ? token : '';
    } catch {
      localStorage.removeItem('auth_token');
      localStorage.removeItem('auth_user');
      return '';
    }
  }

  function renderLocked(){
    const html = `<div class="secret-empty">
      <div><span class="v11-rd">DENIED</span> 관리자 로그인 후 비밀 글 목록을 볼 수 있습니다.</div>
      <div style="margin-top:10px;"><a href="/login" class="v11-gr">login</a></div>
    </div>`;
    document.getElementById('secret-list').innerHTML = html;
    document.getElementById('secret-count').innerHTML = 'admin only';
    document.getElementById('secret-categories').innerHTML = '<span class="v11-dim">관리자 전용</span>';
    document.getElementById('secret-recent').innerHTML = '<span class="v11-dim">관리자 전용</span>';
    document.getElementById('secret-pagination').innerHTML = '';
  }

  function visiblePosts(){
    if(!activeCategory) return allPosts;
    return allPosts.filter(p => String(p.category || '') === activeCategory);
  }

  function syncPageUrl(page){
    const next = new URLSearchParams(window.location.search);
    if(activeCategory) next.set('category', activeCategory); else next.delete('category');
    if(page > 1) next.set('page', String(page)); else next.delete('page');
    const qs = next.toString();
    history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
  }

  function renderCount(total, pageState){
    const el=document.getElementById('secret-count');
    if(!el) return;
    if(activeCategory){
      el.innerHTML=`${total} / ${allPosts.length} · page ${pageState.page}/${pageState.pageCount} · <span class="v11-gr">${esc(activeCategory)}</span> · <a href="/secret">clear</a>`;
      return;
    }
    el.innerHTML=`${allPosts.length} private entries · page ${pageState.page}/${pageState.pageCount}`;
  }

  function render(filteredPosts, pageState){
    const list=document.getElementById('secret-list');
    renderCount(filteredPosts.length, pageState);
    if(!filteredPosts.length){
      list.innerHTML='<div class="secret-empty">조건에 맞는 비밀 글이 없습니다.</div>';
      return;
    }
    list.innerHTML=pageState.items.map(p=>{
      const a=areaFor(p);
      const cover=thumbOf(p);
      const tags=(p.tags||[]).slice(0,3).map(t=>`<span class="v11-tag ${a}">#${esc(t)}</span>`).join('');
      const thumb=cover
        ? `<div class="pi-thumb"><img src="${esc(cover)}" alt="${esc(p.coverAlt||p.title)}" loading="lazy" decoding="async" style="${coverCropStyle(p.cover_crop)}"/></div>`
        : '';
      const draft=p.draft?'<span class="lvl lvl-warn" style="font-size:10px;">draft</span>':'';
      return `<a href="${postUrl(p.slug)}" class="secret-post-item" data-slug="${esc(p.slug)}">
        <div class="pi-body">
          <div class="pi-title">${esc(p.title)} <span class="lvl lvl-warn" style="font-size:10px;">secret</span>${draft}</div>
          ${p.description?`<div class="pi-desc">${esc(p.description)}</div>`:''}
          <div class="pi-meta"><span class="v11-dim">${esc(fmtDate(p.date))}</span><span>${esc(p.category || 'uncategorized')}</span>${tags}</div>
        </div>
        ${thumb}
      </a>`;
    }).join('');
  }

  function categoryEntries(){
    const counts = new Map();
    for(const post of allPosts){
      const category = String(post.category || '').trim();
      if(!category) continue;
      counts.set(category, (counts.get(category) || 0) + 1);
    }
    return [...counts.entries()].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
  }

  function renderCategories(){
    const el=document.getElementById('secret-categories');
    if(!el) return;
    const entries=categoryEntries();
    if(!entries.length){
      el.innerHTML='<span class="v11-dim">카테고리가 없습니다.</span>';
      return;
    }
    const allClass = activeCategory ? '' : ' is-active';
    el.innerHTML=[
      `<a class="secret-category-item${allClass}" href="/secret"><span>all</span><span class="secret-category-count">${allPosts.length}</span></a>`,
      ...entries.map(([category,count])=>{
        const cls=category===activeCategory ? ' is-active' : '';
        return `<a class="secret-category-item${cls}" href="${secretUrl(category)}"><span>${esc(category)}</span><span class="secret-category-count">${count}</span></a>`;
      })
    ].join('');
  }

  function renderRecent(){
    const el=document.getElementById('secret-recent');
    if(!el) return;
    const recent=allPosts.slice(0,5);
    if(!recent.length){
      el.innerHTML='<span class="v11-dim">아직 비밀 글이 없습니다.</span>';
      return;
    }
    el.innerHTML=recent.map(p=>`<a class="secret-recent-item" href="${postUrl(p.slug)}">
      <span>${esc(p.title)}</span>
      <span class="secret-recent-date">${esc(shortDate(p.date))}</span>
    </a>`).join('');
  }

  function renderPage(){
    const posts=visiblePosts();
    const pageState=paginate(posts, activePage, PAGE_SIZE);
    activePage=pageState.page;
    render(posts, pageState);
    renderCategories();
    renderRecent();
    const pager=document.getElementById('secret-pagination');
    if(pager){
      pager.innerHTML=paginationHtml(pageState);
      bindPagination(pager, (page)=>{
        activePage=page;
        syncPageUrl(activePage);
        renderPage();
        document.querySelector('.secret-main')?.scrollIntoView({block:'start'});
      });
    }
    return pageState;
  }

  const IMG_RE=/!\[[^\]]*\]\((https?:\/\/[^)\s"']+)/;
  async function deriveThumbs(posts){
    const need=posts.filter(p=>!p.cover);
    let changed=false;
    await Promise.all(need.map(async (p)=>{
      const key='secret_thumb_'+p.slug;
      let url=sessionStorage.getItem(key);
      if(url===null){
        try{
          const r=await fetch(`${API_BASE}/api/posts/${encodeURIComponent(p.slug)}`, { headers: { Authorization: `Bearer ${authToken}` } });
          if(r.ok){ const d=await r.json(); const m=String(d.content||'').match(IMG_RE); url=m?m[1]:''; }
          else url='';
        }catch{ url=''; }
        try{ sessionStorage.setItem(key, url); }catch{}
      }
      if(url){ p._thumb=url; changed=true; }
    }));
    return changed;
  }

  async function load(){
    authToken = await ensureAdmin();
    if(!authToken){
      renderLocked();
      return;
    }
    try{
      const res=await fetch(`${API_BASE}/api/posts`, { headers: { Authorization: `Bearer ${authToken}` } });
      if(!res.ok) throw new Error('api');
      const data=await res.json();
      allPosts=data.filter(p=>p.is_private).sort((a,b)=>new Date(b.date)-new Date(a.date));
      const pageState=renderPage();
      if(await deriveThumbs(pageState.items)) renderPage();
    }catch(e){
      document.getElementById('secret-list').innerHTML='<div class="v11-rd" style="font-size:12.5px;padding:14px 8px;">비밀 글을 불러오지 못했습니다.</div>';
      document.getElementById('secret-categories').innerHTML='<span class="v11-rd">불러오기 실패</span>';
      document.getElementById('secret-recent').innerHTML='<span class="v11-rd">불러오기 실패</span>';
    }
  }

  load();
</script>
