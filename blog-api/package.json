{
  "name": "blog-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "dev:home": "npm run build:node && node home-server.mjs",
    "start:home": "node home-server.mjs",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy",
    "import:markdown": "node scripts/import-markdown-to-db.mjs",
    "backup:home": "./scripts/backup-home-server.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "pg": "^8.21.0"
  }
}
