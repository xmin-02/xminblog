# Home-server blog API environment for the existing xmin home infra.
# Production target from /Users/sumin/Desktop/home_server_migration_guide.md:
# - API container on vm-public LXC 106 (192.168.45.60)
# - PostgreSQL 16 on vm-db LXC 107 (192.168.45.70:5432)
# - Traefik/cloudflared on vm-edge (192.168.45.20)

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_DRIVER=postgres
DATABASE_URL=postgresql://xminblog:replace-db-password@192.168.45.70:5432/xminblog

# Production content ownership: posts live in PostgreSQL; images live on vm-public disk.
CONTENT_BACKEND=db
UPLOAD_DIR=/app/data/uploads
PUBLIC_UPLOAD_BASE=https://api.xmin.cloud/uploads

# Local smoke-test fallback only; not recommended for production.
# DB_DRIVER=sqlite
# SQLITE_PATH=./data/blog.sqlite
# PUBLIC_UPLOAD_BASE=http://127.0.0.1:3001/uploads

# GitHub settings are optional in CONTENT_BACKEND=db mode and kept only for rollback
# to the legacy GitHub-backed writer.
GITHUB_OWNER=xmin-02
GITHUB_REPO=xminblog
GITHUB_BRANCH=main
# GITHUB_TOKEN=ghp_replace_me

# Admin login: ADMIN_EMAIL + ADMIN_PASSWORD.
# ADMIN_LOGIN_EMAILS is a comma-separated compatibility list for old admin emails.
ADMIN_EMAIL=admin@xmin.blog
# ADMIN_LOGIN_EMAILS=old-admin@example.com
ADMIN_PASSWORD=replace-with-long-random-password
JWT_SECRET=replace-with-32-byte-random-secret

# APNs push notifications for the iOS admin app.
# Create an Apple Push Notifications Auth Key (.p8) in Apple Developer.
# APNS_TOPIC must match the iOS app bundle identifier.
APNS_KEY_ID=replace-apple-key-id
APNS_TEAM_ID=replace-apple-team-id
APNS_TOPIC=sh.xmin.blogadmin
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-p8-key-body\n-----END PRIVATE KEY-----"

# Automation drafts. Generated posts stay as draft + review_status=pending.
# NVD_API_KEY is optional but recommended for rate limits.
# NVD_API_KEY=replace-nvd-api-key
# OPENAI_API_KEY enables AI-written Korean draft bodies. Keep unset for template-only drafts.
# OPENAI_API_KEY=sk-replace-openai-api-key
AI_DRAFTS=1
OPENAI_DRAFT_MODEL=gpt-5.4-mini
OPENAI_DRAFT_MAX_OUTPUT_TOKENS=2600
CVE_LOOKBACK_DAYS=3
CVE_DRAFT_LIMIT=5
CVE_MIN_CVSS_SCORE=8
NVD_MAX_PAGES=3
NVD_RESULTS_PER_PAGE=200
SECURITY_NEWS_LOOKBACK_DAYS=1
SECURITY_NEWS_ITEM_LIMIT=8
# SECURITY_NEWS_FEEDS=https://www.cisa.gov/cybersecurity-advisories/all.xml,https://www.cisa.gov/uscert/ncas/alerts.xml,https://www.cisa.gov/uscert/ncas/current-activity.xml
