[Unit]
Description=xmin.blog automation draft generator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -e AUTOMATION_KIND=all -e CVE_DRAFT_LIMIT=10 -e SECURITY_NEWS_LOOKBACK_DAYS=1 blog-api npm run automate:drafts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
