[Unit]
Description=xmin.blog automation draft generator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec blog-api npm run automate:drafts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
