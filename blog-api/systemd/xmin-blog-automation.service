[Unit]
Description=xmin.blog automation draft generator
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/xminblog/blog-api
EnvironmentFile=/srv/xminblog/blog-api/.env.home
ExecStart=/usr/bin/npm run automate:drafts
User=xminblog
Group=xminblog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
