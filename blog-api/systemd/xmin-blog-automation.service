[Unit]
Description=xmin.blog automation draft generator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -e AUTOMATION_KIND=all -e AUTOMATION_TIME_ZONE=Asia/Seoul -e AUTOMATION_UTC_OFFSET=+09:00 -e CVE_DRAFT_LIMIT=10 -e SECURITY_NEWS_WINDOW_START_HOUR=9 blog-api npm run automate:drafts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
